#!/bin/sh
# Operator-owned entrypoint for both venv and bundled Hermes distributions.
set -eu
PYTHON=/opt/hermes/.venv/bin/python
REPO=/opt/hermes
unset PYTHONPATH PYTHONHOME
PYVER="$($PYTHON -P -c 'import sys; print("python%d.%d" % sys.version_info[:2])')"
SITE="$REPO/.venv/lib/$PYVER/site-packages"
[ -x "$PYTHON" ] && [ -d "$SITE" ] || { echo 'Hermes Python bundle unavailable' >&2; exit 2; }
export PYTHONPATH="$REPO:$SITE"
export HERMES_SITE="$SITE"
export PYTHONPYCACHEPREFIX="${PYTHONPYCACHEPREFIX:-${XDG_CACHE_HOME:-$HOME/.cache}/hermes-pycache}"
exec "$PYTHON" -P -c 'import os,site,sys
sys.argv[0]="hermes"
site.addsitedir(os.environ["HERMES_SITE"])
sys.path.insert(0,"/opt/hermes-paseo-dashboard-control")
from resource_limits import configure_cpu_environment
configure_cpu_environment()
if sys.argv[1:2]==["dashboard"]:
    if os.geteuid()==0:
        raise SystemExit("Start Dashboard as the Hermes service account.")
    from hermes_cli import web_server
    from dashboard_control import install
    install(web_server)
from hermes_cli.main import main
sys.exit(main())
' "$@"
