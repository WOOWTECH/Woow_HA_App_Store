#!/command/with-contenv bash
set -euo pipefail
mkdir -p /data/postgres /run/postgresql
chown -R postgres:postgres /data/postgres /run/postgresql
chmod 700 /data/postgres
if [[ ! -s /data/postgres/PG_VERSION ]]; then
  gosu postgres /usr/lib/postgresql/16/bin/initdb -D /data/postgres --encoding=UTF8 --locale=C.UTF-8 --auth-local=trust --auth-host=scram-sha-256
fi
cat > /data/postgres/postgresql.conf <<'PG'
listen_addresses = ''
unix_socket_directories = '/run/postgresql'
max_connections = 100
shared_buffers = 128MB
logging_collector = off
log_destination = 'stderr'
PG
cat > /data/postgres/pg_hba.conf <<'PGHBA'
local all all trust
PGHBA
chown postgres:postgres /data/postgres/postgresql.conf /data/postgres/pg_hba.conf
