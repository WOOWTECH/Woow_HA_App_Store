#!/command/with-contenv bash
set -euo pipefail
source /run/woow-office/env
until pg_isready -q -h /run/postgresql -U postgres; do sleep 1; done
until redis-cli -s /run/redis/redis.sock ping >/dev/null 2>&1; do sleep 1; done
# An install that was stopped before it finished (container killed during the first-run install:
# Supervisor watchdog during a slow first start, power cut) leaves a config.php without
# 'installed' => true and a partial schema. The upgrade step refuses that ("Nextcloud is not installed"),
# so the add-on would never start again. Only when config.php parses and is not installed: drop it
# and the partial database and install again. A config.php that does not parse is left alone.
if [[ -s /data/nextcloud/config/config.php ]] && php -r 'try { include $argv[1]; } catch (Throwable $e) { exit(2); } exit(isset($CONFIG) && is_array($CONFIG) && empty($CONFIG["installed"]) ? 0 : 1);' -- /data/nextcloud/config/config.php; then
  echo "Nextcloud install did not finish last time; discarding the partial install and installing again."
  # Database first: if this is cut off, config.php is still there and the next start does this again.
  gosu postgres dropdb -h /run/postgresql --if-exists nextcloud
  rm -f /data/nextcloud/config/config.php
fi
# DB/user are idempotent under local socket trust.
DB_PASS_SQL=${DB_PASS//\'/\'\'}
gosu postgres psql -h /run/postgresql -tc "SELECT 1 FROM pg_roles WHERE rolname='nextcloud'" | grep -q 1 || gosu postgres psql -h /run/postgresql -c "CREATE ROLE nextcloud LOGIN PASSWORD '${DB_PASS_SQL}'"
gosu postgres psql -h /run/postgresql -c "ALTER ROLE nextcloud PASSWORD '${DB_PASS_SQL}'" >/dev/null
gosu postgres psql -h /run/postgresql -tc "SELECT 1 FROM pg_database WHERE datname='nextcloud'" | grep -q 1 || gosu postgres createdb -h /run/postgresql -O nextcloud nextcloud
# Persistent config/custom apps/data.
mkdir -p /data/nextcloud/config /data/nextcloud/custom_apps "$NEXTCLOUD_DATADIR"
if [[ ! -L /var/www/nextcloud/config ]]; then rm -rf /var/www/nextcloud/config; ln -s /data/nextcloud/config /var/www/nextcloud/config; fi
if [[ ! -L /var/www/nextcloud/custom_apps ]]; then rm -rf /var/www/nextcloud/custom_apps; ln -s /data/nextcloud/custom_apps /var/www/nextcloud/custom_apps; fi
# App store apps go to the persistent custom_apps (symlink to /data); the image's
# apps/ stays read-only so a new image never silently drops an installed app.
cat > /data/nextcloud/config/apps.config.php <<'APPS'
<?php
$CONFIG = [
  'apps_paths' => [
    ['path' => '/var/www/nextcloud/apps', 'url' => '/apps', 'writable' => false],
    ['path' => '/var/www/nextcloud/custom_apps', 'url' => '/custom_apps', 'writable' => true],
  ],
];
APPS
# Only entries that are not www-data:www-data (e.g. after a restore). The image's tree is already
# owned correctly; chowning it anyway makes overlayfs copy all of it up on every boot.
find /data/nextcloud "$NEXTCLOUD_DATADIR" /var/www/nextcloud \( ! -user www-data -o ! -group www-data \) -exec chown -h www-data:www-data {} +
if [[ ! -s /data/nextcloud/config/config.php ]]; then
  echo "Installing Nextcloud..."
  occ maintenance:install \
    --database pgsql \
    --database-host /run/postgresql \
    --database-name nextcloud \
    --database-user nextcloud \
    --database-pass "$DB_PASS" \
    --admin-user "$ADMIN_USER" \
    --admin-pass "$ADMIN_PASS" \
    --data-dir "$NEXTCLOUD_DATADIR"
else
  if occ upgrade --no-interaction; then
    :
  else
    upgrade_status=$?
    echo "Nextcloud upgrade failed; stopping initialization. Restore a matching validated backup before retrying." >&2
    exit "$upgrade_status"
  fi
fi
# Core config that keeps public/direct URL stable and HA iframe usable, and allows framing by
# HA/public hosts: one write of config.php, same result as one `occ config:system:set` per value
# (each occ call boots Nextcloud; s6 cannot stop the add-on cleanly while this oneshot runs).
PUBLIC_HOST="$PUBLIC_HOST" PUBLIC_URL="$PUBLIC_URL" DEFAULT_PHONE_REGION="$DEFAULT_PHONE_REGION" DB_PASS="$DB_PASS" \
  php /usr/local/share/woow-office/nextcloud-system-config.php /data/nextcloud/config/config.php
# ADMIN_PASS is only an initial-install credential. Preserve the existing
# account password across upgrades/restarts; resets require an explicit action.
occ config:app:set password_policy minLength --value 7 || true
# HA backup/restore does not preserve file modes (seen: config.php 0640 -> 0644 after a
# Supervisor restore). Re-assert them on every boot: config holds DB and instance secrets.
chmod 0750 /data/nextcloud/config
find /data/nextcloud/config -maxdepth 1 -type f -name '*.php' -exec chmod 0640 {} +
chmod 0770 "$NEXTCLOUD_DATADIR"
# Disable first-run modal and notify_push unless explicitly configured later.
occ app:disable firstrunwizard || true
occ app:disable notify_push || true
