#!/command/with-contenv bash
set -euo pipefail
source /run/woow-office/env
if [[ "$ENABLE_COLLABORA" != "true" ]]; then exit 0; fi
for i in $(seq 1 90); do curl -fsS http://127.0.0.1:9980/hosting/capabilities >/dev/null 2>&1 && break; sleep 1; done
for i in $(seq 1 90); do curl -fsS http://127.0.0.1:8000/hosting/discovery >/dev/null 2>&1 && break; sleep 1; done
# Install/enable richdocuments. app:install may fail if already installed or no appstore; continue to app:enable.
occ app:install richdocuments || true
occ app:enable richdocuments || true
# Nextcloud 33 + richdocuments 10.3.x can leave several app routes without a leading slash,
# which makes /apps/richdocuments/token return 404 and prevents Collabora from opening files.
php <<'PHP'
<?php
$p = '/var/www/nextcloud/apps/richdocuments/appinfo/routes.php';
if (is_file($p)) {
    $s = file_get_contents($p);
    $repl = [
        "'url' => 'index'" => "'url' => '/index'",
        "'url' => 'remote'" => "'url' => '/remote'",
        "'url' => 'indexTemplate'" => "'url' => '/indexTemplate'",
        "'url' => 'editonline'" => "'url' => '/editonline'",
        "'url' => 'editonline/{fileId}/{target}'" => "'url' => '/editonline/{fileId}/{target}'",
        "'url' => 'ajax/personal.php'" => "'url' => '/ajax/personal.php'",
        "'url' => 'ajax/admin.php'" => "'url' => '/ajax/admin.php'",
        "'url' => 'ajax/settings.php'" => "'url' => '/ajax/settings.php'",
        "'url' => 'settings/watermark'" => "'url' => '/settings/watermark'",
        "'url' => 'settings/check'" => "'url' => '/settings/check'",
        "'url' => 'settings/demo'" => "'url' => '/settings/demo'",
        "'url' => 'settings/fonts'" => "'url' => '/settings/fonts'",
        "'url' => 'settings/fonts.json'" => "'url' => '/settings/fonts.json'",
        "'url' => 'settings/fonts/{name}'" => "'url' => '/settings/fonts/{name}'",
        "'url' => 'settings/{type}/{token}/{category}/{name}'" => "'url' => '/settings/{type}/{token}/{category}/{name}'",
        "'url' => 'settings/generateToken/{type}'" => "'url' => '/settings/generateToken/{type}'",
        "'url' => 'assets'" => "'url' => '/assets'",
        "'url' => 'assets/tasks'" => "'url' => '/assets/tasks'",
        "'url' => 'assets/{token}'" => "'url' => '/assets/{token}'",
    ];
    file_put_contents($p, strtr($s, $repl));
}
PHP
occ app:disable richdocuments || true
occ app:enable richdocuments || true
# php-fpm starts before this init step; restart it so Nextcloud drops route caches loaded before the patch.
if [[ -s /run/php/php8.2-fpm.pid ]]; then kill -TERM "$(cat /run/php/php8.2-fpm.pid)" || true; sleep 2; fi
# Back-end WOPI URL stays internal; public URL is discovered from coolwsd server_name via discovery.
occ config:app:set --value "http://127.0.0.1:9980" richdocuments wopi_url || true
occ richdocuments:activate-config || true
occ config:app:set --value "$PUBLIC_URL" richdocuments wopi_callback_url || true
# Explicit fallback: keep all three values sane if activate-config is flaky for this richdocuments version.
occ config:app:set --value "$PUBLIC_URL" richdocuments public_wopi_url || true
occ config:app:get richdocuments wopi_url || true
occ config:app:get richdocuments public_wopi_url || true
occ config:app:get richdocuments wopi_callback_url || true
