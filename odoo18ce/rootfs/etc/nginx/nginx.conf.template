daemon off;
pid /var/run/nginx.pid;
worker_processes 1;
error_log /dev/stderr info;

events { worker_connections 1024; }

http {
    log_format safe '$remote_addr - $remote_user [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent "-" "$http_user_agent" xfo="$sent_http_x_frame_options" upstream_xfo="$upstream_http_x_frame_options" proto="$http_x_forwarded_proto" host="$http_host"';
    access_log /dev/stdout safe;
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }
    map $http_x_forwarded_proto $forwarded_proto {
        default $http_x_forwarded_proto;
        '' $scheme;
    }
    map $http_x_forwarded_proto $ingress_proto {
        default https;
        https https;
        http http;
    }
    map $ingress_proto $ingress_cookie_secure {
        https secure;
        default nosecure;
    }
    # What an Ingress prefix is. Home Assistant's path is
    # `/api/hassio_ingress/<token>`, and the token is the *add-on's*
    # `ingress_token` -- one persisted secret per installed add-on, not one per
    # user and not one per session (the session is a separate secret, and it
    # travels in the `ingress_session` cookie). A request whose
    # `X-Ingress-Path` does not match this is served with no prefix at all, so
    # this map decides which prefixes exist.
    #
    # It has a second reader: the markup strip of issue #234
    # (`$ingress_markup_global_shim`) removes any prefix of **this** shape from
    # a value on its way to a record, and not only the one the gateway handed
    # the page -- a collaborative peer's snapshot, or a record the Public
    # origin stored, can carry another token. The two patterns are held
    # together by `tests/test_ingress_peer_snapshot_prefix.py`, which derives
    # both from this file; change the shape here and that test says where else
    # it is read.
    map $http_x_ingress_path $safe_ingress_path {
        default "";
        "~^/api/hassio_ingress/[A-Za-z0-9_-]{16,128}$" $http_x_ingress_path;
    }

    # `sub_filter_types` applies to every rule in a location. Keep the generic
    # ingress JSON URL rewrites enabled, but make the runtime shim itself a
    # content-type-aware replacement: embedded preview HTML in JSON must remain
    # JSON rather than receiving raw script bytes.
    #
    # The Runtime shim is two scripts. nginx reads a single quoted parameter
    # into a 4096-byte buffer and refuses the file ("too long parameter") when
    # one exceeds it; the prefix script below is close to that limit, so every
    # other part of the Runtime shim lives in its own map and is spliced into
    # `$ingress_runtime_shim` by variable reference, as the clipboard script
    # is. That keeps this map -- the text/html gate -- as the single place the
    # shim is assembled, whatever injects it: the `<head>` rule is written once
    # per Ingress location that can answer with a page, which since issue #158
    # means the generic `location /` and the action-load location that copies
    # it. Both carry the same rule and both read this map, so a JSON answer
    # gets the empty replacement either way.
    #
    # Clipboard script (issue #60). Home Assistant opened over plain http on
    # the LAN is a supported usage, and that page is not a secure context, so
    # `navigator.clipboard` does not exist inside the Ingress iframe and every
    # Odoo copy button throws on `writeText`. When it is absent this defines
    # `writeText` over a temporary textarea and `document.execCommand("copy")`,
    # which still works without a secure context as long as it runs inside the
    # user's click, then hands focus back to the element that had it. A real
    # `navigator.clipboard` (HA over https) is never touched, and `write()`
    # stays absent so Odoo keeps its own error path for Blob payloads.
    map $upstream_http_content_type $ingress_clipboard_shim {
        default '<script>(function(){try{if(!navigator.clipboard){var CB={writeText:function(t){return new Promise(function(ok,no){var d=document,f=d.activeElement,ta=d.createElement("textarea"),done=false;ta.value=String(t);ta.setAttribute("readonly","");ta.setAttribute("aria-hidden","true");ta.style.position="fixed";ta.style.top="0";ta.style.left="0";ta.style.width="1px";ta.style.height="1px";ta.style.opacity="0";(d.body||d.documentElement).appendChild(ta);try{ta.select();if(ta.setSelectionRange)ta.setSelectionRange(0,ta.value.length);done=d.execCommand("copy")===true}catch(e){done=false}if(ta.parentNode)ta.parentNode.removeChild(ta);if(f&&f.focus)f.focus();if(done)ok();else no(new Error("clipboard write failed"))})}};try{Object.defineProperty(navigator,"clipboard",{value:CB,configurable:true,writable:true})}catch(e){navigator.clipboard=CB}}}catch(e){}})()</script>';
    }

    # Canonical URL script (issue #70). Odoo 18 builds some outbound links in
    # the browser, from the address in the address bar: the Discuss invitation
    # link is `window.location.origin` joined to `/chat/<id>/<uuid>`, and
    # `@web/core/utils/urls` falls back to the browser protocol and host
    # because Odoo 18 session info carries no origin. Through Ingress that
    # address is the Home Assistant host, so the link is useless to the person
    # it is sent to, and the lock the maintenance bootstrap puts on
    # web.base.url cannot reach it: the value never passes through the server.
    #
    # This publishes the Canonical URL to the page. It changes no address by
    # itself; each Literal rewrite that moves a browser-built outbound link
    # onto this base is added one exact expression at a time. An empty value
    # -- Ingress-only, with the Supervisor reporting no LAN address -- leaves
    # every one of them on the browser origin, which is today's behaviour.
    #
    # The global is read-only so a bundle cannot move the base of a link that
    # has already been rewritten, and it carries no trailing slash because
    # canonical_url() in the maintenance library strips one.
    map $upstream_http_content_type $ingress_canonical_url_shim {
        default '<script>(function(){var U="%%CANONICAL_URL%%";try{Object.defineProperty(window,"__WOOW_CANONICAL_URL__",{value:U,writable:false,configurable:false,enumerable:true})}catch(e){window.__WOOW_CANONICAL_URL__=U}})()</script>';
    }

    # Injection-way and media-source hooks (issues #169, #159). Not a script of
    # its own: this is the tail of the prefix script's IIFE below, spliced in by
    # variable reference because that script is close to nginx's parameter
    # buffer -- `tests/test_nginx_parameter_budget.py` measures how close and
    # holds a reserve against it. It runs inside the same closure and so
    # prefixes through the same path() helper, and reuses the same prop()
    # property-setter wrapper; there is no second URL helper.
    #
    # Group A of the #169 decision -- the ways the shim can intercept without
    # ever writing a URL back into record content: `navigator.sendBeacon`, the
    # `EventSource` constructor, and the SVG `<use>` reference set through
    # `setAttributeNS` (a namespace's local `href`/`src`/`action`).
    # `setAttribute("xlink:href", ...)` is the same way through the other API
    # and is handled by the setAttribute wrapper below, beside href/src/action.
    #
    # Group B stays uncovered by decision, and nothing here touches it: HTML
    # inserted as markup (`innerHTML`, `insertAdjacentHTML`, `outerHTML`), the
    # `style` attribute, and the text of a dynamic `<style>` element. The HTML
    # editor and the website editor load and save record content through those
    # paths, so a hook there would write the Ingress prefix -- which carries
    # the Ingress token -- into the database: that breaks the Public origin and
    # leaks the token. A screen that hits one of them gets a route-scoped
    # Literal rewrite of its own instead (#158, #170). ADR 0004's postscript
    # records both groups.
    #
    # Media sources (#159). Odoo's event barcode client action builds the
    # Registration Desk sounds with
    # `new Audio(url("/barcodes/static/src/audio/error.ogg"))` -- an absolute
    # same-origin URL -- and the shim wrapped nothing for media, so under
    # Ingress the request reached the Home Assistant root and answered 404: a
    # scanner silent on a failed scan. The Rewrite scan lists `/barcodes/` as
    # `INFO`, "the shim intercepts it", which was not true of this consumer.
    # So the `Audio` constructor is wrapped -- keeping `prototype` the way the
    # `Worker` wrapper does, and leaving `new Audio()` with no argument alone --
    # and the `src` setter of `HTMLMediaElement.prototype` (`<audio>` and
    # `<video>`) and of `HTMLSourceElement.prototype` goes through prop().
    # That covers every media prefix at once, where a Generated rewrite would
    # cover one prefix at a time. A string and a `URL` object are both prefixed,
    # as `fetch` and `sendBeacon` take either; anything else is handed to the
    # browser as it came, which is what path() does too. `<track>`,
    # `<embed>`/`<object>`, `poster`, `srcObject`, `HTMLSourceElement.srcset`
    # (the responsive `<picture>` candidate list, not a media source) and CSS
    # `url(...)` media have not been reported escaping and stay uncovered.
    map $upstream_http_content_type $ingress_injection_hooks_shim {
        default 'var SB=navigator.sendBeacon;if(SB)navigator.sendBeacon=function(u,d){if(typeof u==="string")arguments[0]=path(u);else if(u instanceof URL)arguments[0]=path(u.href);return SB.apply(this,arguments)};var ES=window.EventSource;if(ES){window.EventSource=function(u,o){return new ES(path(String(u)),o)};window.EventSource.prototype=ES.prototype;window.EventSource.CONNECTING=ES.CONNECTING;window.EventSource.OPEN=ES.OPEN;window.EventSource.CLOSED=ES.CLOSED}var AN=Element.prototype.setAttributeNS;Element.prototype.setAttributeNS=function(s,n,v){var l=String(n).split(":").pop();if((l==="href"||l==="src"||l==="action")&&typeof v==="string")v=path(v);return AN.call(this,s,n,v)};var AU=window.Audio;if(AU){window.Audio=function(s){return arguments.length?new AU(typeof s==="string"?path(s):s instanceof URL?path(s.href):s):new AU()};window.Audio.prototype=AU.prototype}prop(window.HTMLMediaElement&&HTMLMediaElement.prototype,"src");prop(window.HTMLSourceElement&&HTMLSourceElement.prototype,"src");';
    }

    # The URL helper the shim publishes (issue #174). Not a script of its own
    # either: this is the last statement of the prefix script's IIFE, spliced
    # in by variable reference because that script is close to nginx's
    # parameter buffer -- how close is measured, and the move this splice is
    # an instance of is described, in `tests/test_nginx_parameter_budget.py`;
    # no figure is kept here, because the one that was went stale.
    # It runs inside the same closure, so
    # `path` here is the one helper the fetch, XHR, `window.open` and
    # attribute wrappers already use -- there is no second URL helper, and no
    # value can be prefixed twice by going through both.
    #
    # ADR 0004 makes the Runtime shim the single Ingress URL authority for
    # anything it can intercept. A write to `location` is not one of those:
    # the shim cannot wrap it, and a Literal rewrite cannot prefix a URL that
    # is not in the bundle because it arrived over RPC. So the two expressions
    # that write `location` with a server-supplied URL are rewritten to call
    # this global instead, which keeps the prefixing in one place rather than
    # copying `path()` into a `sub_filter` replacement.
    #
    # Read-only and non-configurable, the way __WOOW_CANONICAL_URL__ is, so a
    # bundle cannot replace the helper a rewritten expression will call. The
    # IIFE returns before this line when the prefix is empty, so the global
    # exists only under Ingress -- and every rewritten expression falls back
    # to the raw value when it is absent.
    map $upstream_http_content_type $ingress_url_global_shim {
        default 'try{Object.defineProperty(window,"__WOOW_INGRESS_URL__",{value:path,writable:false,configurable:false,enumerable:true})}catch(e){window.__WOOW_INGRESS_URL__=path}';
    }

    # The markup helpers the shim publishes (issue #210). Two string
    # functions, not a hook: ADR 0004 leaves markup insertion uncovered
    # because the HTML editor loads *and saves* record content through it, so
    # a shim hook on `innerHTML` would write the token-bearing Ingress prefix
    # into the database. The onboarding to-do's description is exactly that
    # case -- `project_todo` copies `todo_user_onboarding` into
    # `project.task.description`, `<img src="/project_todo/static/img/...">`
    # and all, and under Ingress the two pictures were fetched from the Home
    # Assistant root and answered 404. The route the value arrives on is
    # `/web/dataset/call_kw`, which is the one response ADR 0004 refuses to
    # rewrite, so the prefix goes on where the markup is *rendered* and comes
    # off again on every value the field hands back.
    #
    # `__WOOW_INGRESS_MARKUP_IN__(html)` prefixes URL attributes in a markup
    # string through the shim's own `path()` -- one URL helper, so `blob:`,
    # `data:`, `#`, cross-origin, protocol-relative, a value that is already
    # prefixed and a non-string all behave as they do everywhere else.
    #
    # It matches in two steps, and both of them are about *not* matching the
    # wrong thing. `mT` selects a **start tag** (`<`, a letter, then no `<`
    # or `>`), so an attribute-shaped run of text -- an escaped code sample,
    # prose, an end tag -- is not a candidate, which a single attribute regex
    # over the whole string could not promise. Then `mA` walks that tag
    # *attribute by attribute*, and only a name in `mU` with a quoted value
    # beginning `/` is handed to `path()`.
    #
    # Walking rather than searching is what keeps an earlier attribute's
    # contents out of it: in `<img alt='a" src="/x' src="/y">` the `alt` value
    # is consumed as one token, so the `src=` inside it is never seen and the
    # real `src` is still the one prefixed. A pattern that searched for
    # `src="` would open its value at the wrong quote and restructure the tag
    # -- losing the real `src` -- and the strip cannot undo that, because it
    # only removes a prefix.
    #
    # Which is why the walk **consumes more than it prefixes**, and that is
    # the rule rather than the list: any attribute it cannot tokenise is an
    # attribute whose value it then searches inside, which is the same defect
    # again. So the name is anything but whitespace, `=`, `/`, `<`, `>` or a
    # quote -- the HTML attribute-name shape, not the four names; the
    # whitespace around the `=` is taken and put back unchanged; an
    # **unquoted** value is consumed as a token too, even though nothing
    # unquoted is ever prefixed (there is no delimiter to put back); and an
    # attribute may begin at a **quote** as well as at whitespace, because
    # `<a href="/x"title="y">` is legal and minified HTML writes it. That
    # last one is why the quoted value ends on a *lookahead*: the closing
    # quote stays in the string rather than being consumed, so it is there to
    # be the next attribute's opener, and the replacement re-emits only up to
    # the value. Five review rounds each found this defect through a
    # different spelling -- a `:` in the name, a `.` or `_`, `alt = '...'`,
    # `alt= href='...'`, and no separator at all.
    #
    # Two shapes stay outside the pair and both fail safely -- the URL keeps
    # escaping rather than being corrupted. A start tag holding a `>` inside
    # an attribute value is not recognised as a tag at all. And an unquoted
    # value that is itself a URL is not prefixed. What *is* reached and is
    # not really an attribute is markup nested inside another attribute's
    # value, a start tag written inside a comment, and a `src="..."` inside
    # somebody's unquoted value (`alt=a"src="/x"`, where a browser reads one
    # `alt` and no `src`): all three are prefixed, and the strip undoes that
    # on the way to the record.
    #
    # Only the four attributes whose whole value is one URL are prefixed:
    # `src`, `href`, `action`, `data-src`. `srcset` is a candidate list
    # needing a parse and belongs to #166 with every other attribute rule,
    # and `style` backgrounds inside record HTML stay as they are (#194
    # covers page HTML). The value runs to the *matching* quote -- the class
    # excludes whichever quote opened it and not both, so a `'` in a
    # double-quoted `src` (`Mary's photo.png`) is part of the URL and not the
    # end of it. The name test is case-insensitive, because `mT` accepts an
    # uppercase tag name and `<IMG SRC="...">` is legal HTML somebody can
    # paste into the code view, and it is an *exact* name, so
    # `data-original-src` is not a `data-src`. The name the *walk* consumes is
    # a different and much wider thing, for the reason given above. It is a comma-delimited
    # `indexOf` and not an anchored regex, because an anchored regex needs a
    # `$` and nginx reads a `$` in a quoted parameter as a variable -- with
    # `/i` after it, as an invalid one, which `nginx -t` refuses. The
    # Static-tier test renders the whole template through a real nginx, which
    # is how that was found rather than shipped.
    #
    # A value is a candidate only if its first byte is `/` and its second is
    # neither `/` (47) nor a backslash (92). The leading `/` leaves a
    # relative value alone, because prefixing it would *resolve* it and the
    # resolved path is not what the record held. Excluding the second
    # character leaves a protocol-relative reference alone, which is the
    # limit every other prefix rule in this template has and #166 owns:
    # without it `path()` would return a *same-host* `//host/x` as a prefixed
    # root-relative path, and the strip would then store `/x` -- a silently
    # rewritten link rather than an unfixed one. A cross-origin `//host/x`
    # was never at risk; `path()` returns it as it came. The backslash is
    # there because the URL parser treats `/\host/x` as `//host/x` for an
    # http(s) base, so it is the same hazard spelled differently; it is
    # tested by character code rather than as a literal, because nginx turns
    # `\\` in a quoted parameter into one backslash and would leave the
    # JavaScript with an unterminated string.
    #
    # `path()` normalises what it does prefix the way the browser resolves a
    # URL, so a value already in normal form round-trips byte for byte and
    # one that is not (a literal space, a non-ASCII filename, a `..`
    # segment) comes back percent-encoded or collapsed -- the same address,
    # different bytes, and the Static-tier test pins each shape.
    #
    # `__WOOW_INGRESS_MARKUP_OUT__(value)` removes **every** occurrence of the
    # prefix from a string. It is deliberately wider than `IN` rather than its
    # mirror, because that is what makes the record safe whatever `IN`
    # reached, and because the shim's own wrappers put the prefix on
    # attributes `IN` never touches (`xlink:href` through `setAttribute`,
    # `srcset` through the property setter) and on an image
    # `savePendingImages` re-points after the editor has handed its content
    # over. Removing the prefix is always the right answer for a value on its
    # way to storage: the prefix carries the Supervisor token, so an
    # occurrence of it in a record is the harm and not content worth keeping
    # -- including one a user typed, which the test says out loud.
    #
    # **Every occurrence of a prefix, not of the prefix** (issue #234). `P` is
    # the one the gateway handed this page, and a value on its way to a record
    # can carry another: the To-do description is `'collaborative': true`, and
    # the collaboration transport ships serialised attributes byte for byte,
    # which the receiving peer applies through `setAttribute` -- so the sending
    # page's prefix arrives in the receiver's editable and the receiver's save
    # is what would store it. The token in it is the add-on's rather than the
    # user's, so two sessions of one add-on share it and `P` already covered
    # that pair; a prefix `P` does not match arrives when the add-on's token is
    # not the one in the value -- a reinstall or a restored backup mints a new
    # one, a second add-on or a second Home Assistant can reach the same
    # database, and a peer on the Public origin stores what it was sent and has
    # no shim to strip anything. So `mS` is the shape `$safe_ingress_path`
    # validates (the map at the top of this file is the authority; a test holds
    # the two together) and the strip removes every match of it as well as
    # every occurrence of `P`.
    #
    # Both strips are needed, and in that order. `P` is removed whatever its
    # shape, because the gateway is what decided it was a prefix and the value
    # is in the page; the shape strip is for prefixes this page never saw. A
    # token longer than the map accepts is left **alone** rather than cut to
    # the bound -- the trailing lookahead is what refuses it -- because a
    # URL with bytes taken out of its middle is worse than the escape, which
    # is measured and reversible. And the strip stays the only place that
    # knows the shape: `IN` does not heal a foreign prefix, it stacks this
    # page's on top as it always did, so a picture a peer sent is fetched from
    # a path that 404s until the value is saved and reloaded. Rewriting
    # somebody else's address into ours on the way *in* would be changing a
    # value that is still the record's; the record is made clean on the way
    # out, where the token is the harm.
    #
    # `__WOOW_INGRESS_MARKUP_IN_VALUE__(value)` is `IN` for a value that may be
    # an OWL `Markup` object rather than a string (added by issue #237 for the
    # readonly `HtmlViewer`; issue #238 made it the helper **every** markup
    # insertion in this family calls, because the value at all of them is
    # `record.data[name]`). Every html field holds its value as `markup(...)`
    # -- the relational model wraps an `html` field that way -- and `IN`
    # returns a non-string as it came, so calling `IN` on one would be a silent
    # no-op. This helper puts the wrapper back through the value's **own**
    # constructor, because OWL's `t-out` inserts a `Markup` as HTML and
    # *escapes* everything else: a prefixed plain string handed back there
    # would be displayed as text rather than rendered, which is a worse bug
    # than the one being fixed. A primitive string goes through `IN`
    # unchanged, which is why the one helper serves a `t-out`, an `innerHTML`
    # and jQuery's `.html()` alike -- each takes a string as markup too -- and
    # anything else (an empty html field is `false`) comes back as it came
    # rather than as the word "false". Being **type-preserving** is the
    # property its callers rely on, not an implementation detail: `t-out`
    # branches on `instanceof Markup` and jQuery's `.html()` on `typeof value
    # === "string"`, so a helper that normalised the type would change which
    # code path runs.
    #
    # Each caller spells its fallback out -- `(window.X||function(h){return h})`
    # -- rather than referencing a `map` that could carry those bytes once. That
    # is deliberate and the same choice every rewrite in this file makes: a
    # reader of one `sub_filter` line can see what the page gets without
    # resolving a variable, and `grep` for a helper finds its call sites. The
    # cost is bytes in a `sub_filter` parameter, which has the whole 4096-byte
    # token to itself; the shim's own script is the parameter that is short of
    # room, and no fallback lives in it.
    #
    # Read-only and non-configurable like `__WOOW_INGRESS_URL__`, published
    # only when the Ingress prefix is non-empty because the IIFE returns
    # before this line otherwise, and every rewritten expression falls back to
    # the untouched value when the globals are absent.
    map $upstream_http_content_type $ingress_markup_global_shim {
        default 'var mT=/<[A-Za-z][^<>]*>/g,mA=/(^|\s|[\x22\x27])([^\s=\/<>\x22\x27]+)(\s*=\s*)(?:([\x22\x27])((?:(?!\4)[^<>])*)(?=\4)|[^\s<>\x22\x27]+)/g,mU=function(n){return ",src,href,action,data-src,".indexOf(","+n.toLowerCase()+",")>=0},mF=function(m,s,n,e,q,v){return q&&mU(n)&&v.charAt(0)==="/"&&v.charCodeAt(1)!==47&&v.charCodeAt(1)!==92?s+n+e+q+path(v):m},mIn=function(h){return typeof h==="string"?h.replace(mT,function(g){return g.replace(mA,mF)}):h},mIV=function(v){return v instanceof String?new v.constructor(mIn(v.toString())):mIn(v)},mS=/\/api\/hassio_ingress\/[A-Za-z0-9_-]{16,128}(?![A-Za-z0-9_-])/g,mOut=function(s){if(typeof s!=="string")return s;if(s.indexOf(P)>=0)s=s.split(P).join("");return s.replace(mS,"")},mP=function(k,f){try{Object.defineProperty(window,k,{value:f,writable:false,configurable:false,enumerable:true})}catch(e){window[k]=f}};mP("__WOOW_INGRESS_MARKUP_IN__",mIn);mP("__WOOW_INGRESS_MARKUP_IN_VALUE__",mIV);mP("__WOOW_INGRESS_MARKUP_OUT__",mOut)';
    }

    map $upstream_http_content_type $ingress_runtime_shim {
        default "";
