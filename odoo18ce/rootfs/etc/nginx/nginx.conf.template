daemon off;
pid /var/run/nginx.pid;
worker_processes 1;
error_log /dev/stderr info;

events { worker_connections 1024; }

http {
    log_format safe '$remote_addr - $remote_user [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent "-" "$http_user_agent" xfo="$sent_http_x_frame_options" upstream_xfo="$upstream_http_x_frame_options" proto="$http_x_forwarded_proto" host="$http_host"';
    access_log /dev/stdout safe;
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }
    map $http_x_forwarded_proto $forwarded_proto {
        default $http_x_forwarded_proto;
        '' $scheme;
    }
    map $http_x_forwarded_proto $ingress_proto {
        default https;
        https https;
        http http;
    }
    map $ingress_proto $ingress_cookie_secure {
        https secure;
        default nosecure;
    }
    map $http_x_ingress_path $safe_ingress_path {
        default "";
        "~^/api/hassio_ingress/[A-Za-z0-9_-]{16,128}$" $http_x_ingress_path;
    }

    upstream odoo_http { server 127.0.0.1:8070; }
    upstream odoo_websocket { server 127.0.0.1:%%WS_PORT%%; }

    # Internal public origin. The host port is not published; cloudflared
    # reaches this listener through the add-on's hassio-network DNS name.
    server {
        listen 8069 default_server;
        client_max_body_size 512M;
        %%PUBLIC_HOST_GUARD%%

        # Database lifecycle operations are deliberately HA-Ingress-only.
        location ^~ /web/database/ { return 404; }
        location = /xmlrpc/db { return 404; }
        location = /xmlrpc/2/db { return 404; }
        location = /jsonrpc {
            proxy_pass http://127.0.0.1:8071;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header X-Forwarded-Proto %%PUBLIC_PROTO%%;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_request_buffering off;
            proxy_read_timeout 720s;
        }

        location = /websocket {
            proxy_pass http://odoo_websocket;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header X-Forwarded-Proto %%PUBLIC_PROTO%%;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_read_timeout 3600s;
        }

        location / {
            proxy_pass http://odoo_http;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header X-Forwarded-Proto %%PUBLIC_PROTO%%;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_request_buffering off;
            proxy_read_timeout 720s;
            proxy_send_timeout 720s;
            proxy_cookie_flags session_id secure httponly samesite=lax;
        }
    }

    # HA Supervisor Ingress adapter.
    server {
        listen 5691;
        absolute_redirect off;
        allow 172.30.32.2;
        deny all;
        client_max_body_size 512M;

        location = /websocket {
            proxy_pass http://odoo_websocket;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $http_host;
            proxy_set_header Origin $ingress_proto://$http_host;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header X-Forwarded-Proto $ingress_proto;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_read_timeout 3600s;
        }

        # Rewrite route literals only in Odoo asset bundles. Applying these
        # substitutions to HTML would alter hidden login redirect values and
        # make nginx prepend the ingress token twice.
        location ^~ /web/assets/ {
            proxy_pass http://odoo_http;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header X-Forwarded-Proto $ingress_proto;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header Accept-Encoding "";
            proxy_buffering off;
            proxy_hide_header Cache-Control;
            proxy_hide_header Expires;
            proxy_hide_header ETag;
            add_header Cache-Control "no-store, no-cache, must-revalidate" always;

            sub_filter_once off;
            sub_filter_types application/javascript text/javascript text/css;
            sub_filter 'url(/' 'url($safe_ingress_path/';
            sub_filter "url('/" "url('$safe_ingress_path/";
            sub_filter 'url("/' 'url("$safe_ingress_path/';
            sub_filter '"/web/' '"$safe_ingress_path/web/';
            sub_filter "'/web/" "'$safe_ingress_path/web/";
            sub_filter '`/web/' '`$safe_ingress_path/web/';
            sub_filter '"/website/' '"$safe_ingress_path/website/';
            sub_filter "'/website/" "'$safe_ingress_path/website/";
            sub_filter '`/website/' '`$safe_ingress_path/website/';
            sub_filter '"/mail/' '"$safe_ingress_path/mail/';
            sub_filter "'/mail/" "'$safe_ingress_path/mail/";
            sub_filter '`/mail/' '`$safe_ingress_path/mail/';
            sub_filter '"/calendar/' '"$safe_ingress_path/calendar/';
            sub_filter "'/calendar/" "'$safe_ingress_path/calendar/";
            sub_filter '`/calendar/' '`$safe_ingress_path/calendar/';
            sub_filter '"/base_setup/' '"$safe_ingress_path/base_setup/';
            sub_filter "'/base_setup/" "'$safe_ingress_path/base_setup/";
            sub_filter '`/base_setup/' '`$safe_ingress_path/base_setup/';
            sub_filter '"/my/' '"$safe_ingress_path/my/';
            sub_filter "'/my/" "'$safe_ingress_path/my/";
            sub_filter '`/my/' '`$safe_ingress_path/my/';
            sub_filter '"/report/' '"$safe_ingress_path/report/';
            sub_filter '"/odoo' '"$safe_ingress_path/odoo';
            sub_filter "'/odoo" "'$safe_ingress_path/odoo";
            sub_filter '`/odoo' '`$safe_ingress_path/odoo';
            sub_filter 'scope:"/odoo"' 'scope:"$safe_ingress_path/odoo"';
            # Odoo's router only recognizes paths beginning /odoo. Parse a
            # cloned URL without the HA token prefix so history callers retain
            # their original ingress-prefixed URL.
            sub_filter 'function urlToState(urlObj){const{pathname,hash,search}=urlObj;' 'function urlToState(urlObj){if("$safe_ingress_path"&&urlObj.pathname.indexOf("$safe_ingress_path/")===0){urlObj=new URL(urlObj);urlObj.pathname=urlObj.pathname.slice("$safe_ingress_path".length)}const{pathname,hash,search}=urlObj;';
            sub_filter 'browser.location.host===url.host&&browser.location.pathname.startsWith("/odoo")&&(["/web","/odoo"].includes(url.pathname)||url.pathname.startsWith("/odoo/"))&&ev.target.target!=="_blank"){ev.preventDefault();state=router.urlToState(url);if(url.pathname.startsWith("/odoo")&&url.hash)' 'browser.location.host===url.host&&(browser.location.pathname==="$safe_ingress_path/odoo"||browser.location.pathname.startsWith("$safe_ingress_path/odoo/"))&&(["$safe_ingress_path/web","$safe_ingress_path/odoo"].includes(url.pathname)||url.pathname.startsWith("$safe_ingress_path/odoo/"))&&ev.target.target!=="_blank"){ev.preventDefault();state=router.urlToState(url);if((url.pathname==="$safe_ingress_path/odoo"||url.pathname.startsWith("$safe_ingress_path/odoo/"))&&url.hash)';
            sub_filter 'browser.location.origin+router.stateToUrl' 'browser.location.origin+"$safe_ingress_path"+router.stateToUrl';
            # Keep params.serverURL equal to window.origin so Odoo creates a
            # normal same-origin SharedWorker (not a data: URL worker). Prefix
            # only the worker script and WebSocket endpoint expressions.
            sub_filter 'params.serverURL}/bus/websocket_worker_bundle' 'params.serverURL}$safe_ingress_path/bus/websocket_worker_bundle';
            sub_filter 'serverURL.replace("http", "ws")}/websocket' 'serverURL.replace("http", "ws")}$safe_ingress_path/websocket';
            # SharedWorkers are keyed by origin and name. Version both the
            # worker identity and imported bundle so an open browser cannot
            # reuse a pre-upgrade worker that still targets root /websocket.
            sub_filter '"odoo:websocket_shared_worker"' '"odoo:websocket_shared_worker_%%INGRESS_CACHE_VERSION%%"';
            sub_filter '"odoo:websocket_worker"' '"odoo:websocket_worker_%%INGRESS_CACHE_VERSION%%"';
            sub_filter 'websocket_worker_bundle?v=' 'websocket_worker_bundle?woow_ingress=%%INGRESS_CACHE_VERSION%%&v=';
        }

        location / {
            proxy_pass http://odoo_http;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header X-Forwarded-Proto $ingress_proto;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header Accept-Encoding "";
            # Odoo backend responses use X-Frame-Options: DENY, which makes
            # the authenticated /odoo document fail before any assets load in
            # Home Assistant's ingress iframe. HA session auth is the frame
            # boundary, so remove this header only on the ingress listener.
            proxy_hide_header X-Frame-Options;
            proxy_request_buffering off;
            proxy_buffering off;
            proxy_read_timeout 720s;
            proxy_send_timeout 720s;

            proxy_redirect ~^(?<odoo_redirect>/.*)$ $safe_ingress_path$odoo_redirect;
            proxy_cookie_path / $safe_ingress_path/;
            proxy_cookie_flags session_id $ingress_cookie_secure httponly samesite=lax;

            sub_filter_once off;
            sub_filter_types application/javascript text/javascript text/css application/json;
            sub_filter 'href="/' 'href="$safe_ingress_path/';
            sub_filter 'src="/' 'src="$safe_ingress_path/';
            sub_filter 'action="/' 'action="$safe_ingress_path/';
            sub_filter 'data-src="/' 'data-src="$safe_ingress_path/';
            sub_filter 'srcset="/' 'srcset="$safe_ingress_path/';
            # Rewritten asset bytes change with ingress releases while Odoo's
            # content hash does not. Cache-bust HTML references so clients do
            # not keep an older transformed bundle after an add-on update.
            sub_filter '.min.js"' '.min.js?woow_ingress=%%INGRESS_CACHE_VERSION%%"';
            sub_filter '.min.css"' '.min.css?woow_ingress=%%INGRESS_CACHE_VERSION%%"';
            sub_filter '&#39;/web/login&#39;' '&#39;$safe_ingress_path/web/login&#39;';
            sub_filter '"translationURL": "/website/' '"translationURL": "$safe_ingress_path/website/';
            # /web/bundle returns JSON objects such as {"src": "/web/assets/..."}.
            # The Website editor may inject those assets into a child iframe
            # whose DOM prototypes are outside the parent runtime shim.
            sub_filter '"src": "/' '"src": "$safe_ingress_path/';
            sub_filter '"icon":"/' '"icon":"$safe_ingress_path/';
            sub_filter '"icon": "/' '"icon": "$safe_ingress_path/';
            sub_filter '"imgurl":"/' '"imgurl":"$safe_ingress_path/';
            sub_filter '"imgurl": "/' '"imgurl": "$safe_ingress_path/';
            sub_filter '`/web/webclient/' '`$safe_ingress_path/web/webclient/';
            sub_filter 'url(/' 'url($safe_ingress_path/';
            sub_filter "url('/" "url('$safe_ingress_path/";
            sub_filter 'url("/' 'url("$safe_ingress_path/';

            sub_filter '<head>' '<head><script>window.__INGRESS_PATH__="$safe_ingress_path";(function(){var P=window.__INGRESS_PATH__||"";if(!P)return;var path=function(u){if(typeof u!=="string")return u;if(u.charAt(0)==="#")return u;try{var x=new URL(u,location.href);if(x.origin===location.origin){var q=x.pathname+x.search+x.hash;while(q.indexOf(P+P)===0)q=q.slice(P.length);if(q.indexOf(P)===0)return q;if(q.charAt(0)==="/")return P+q}}catch(e){}return u};var F=window.fetch;window.fetch=function(i,o){if(typeof i==="string")i=path(i);else if(i instanceof URL)i=path(i.href);else if(i&&i.url){var u=path(i.url);if(u!==i.url)i=new Request(u,i)}return F(i,o)};var X=XMLHttpRequest.prototype.open;XMLHttpRequest.prototype.open=function(m,u){arguments[1]=path(u);return X.apply(this,arguments)};var H=function(fn){return function(s,t,u){if(typeof u==="string")arguments[2]=path(u);else if(u instanceof URL)arguments[2]=path(u.href);return fn.apply(this,arguments)}};var HP=History.prototype.pushState,HR=History.prototype.replaceState;History.prototype.pushState=H(HP);History.prototype.replaceState=H(HR);var A=Element.prototype.setAttribute;Element.prototype.setAttribute=function(n,v){if((n==="href"||n==="src"||n==="action")&&typeof v==="string")v=path(v);return A.call(this,n,v)};var prop=function(proto,n){if(!proto)return;var d=Object.getOwnPropertyDescriptor(proto,n);if(!d||!d.set)return;Object.defineProperty(proto,n,{get:d.get,set:function(v){return d.set.call(this,path(v))},configurable:true})};prop(window.HTMLAnchorElement&&HTMLAnchorElement.prototype,"href");prop(window.HTMLLinkElement&&HTMLLinkElement.prototype,"href");prop(window.HTMLScriptElement&&HTMLScriptElement.prototype,"src");prop(window.HTMLImageElement&&HTMLImageElement.prototype,"src");prop(window.HTMLImageElement&&HTMLImageElement.prototype,"srcset");prop(window.HTMLFormElement&&HTMLFormElement.prototype,"action");var O=window.open;window.open=function(u){if(typeof u==="string")arguments[0]=path(u);return O.apply(this,arguments)};var WK=window.Worker;if(WK){window.Worker=function(u,o){return new WK(path(String(u)),o)};window.Worker.prototype=WK.prototype}var SW=window.SharedWorker;if(SW){window.SharedWorker=function(u,o){return new SW(path(String(u)),o)};window.SharedWorker.prototype=SW.prototype}var W=window.WebSocket;window.WebSocket=function(u,p){var s=String(u),h=location.host;if(s.indexOf("ws://"+h)===0||s.indexOf("wss://"+h)===0){var x=new URL(s);if(x.pathname.indexOf(P)!==0)x.pathname=P+x.pathname;s=x.toString()}return p===undefined?new W(s):new W(s,p)};window.WebSocket.prototype=W.prototype;window.WebSocket.CONNECTING=W.CONNECTING;window.WebSocket.OPEN=W.OPEN;window.WebSocket.CLOSING=W.CLOSING;window.WebSocket.CLOSED=W.CLOSED;try{if(navigator.serviceWorker){var C={addEventListener:function(){},removeEventListener:function(){},postMessage:function(){}};var K="woow-odoo-sw-clean-%%INGRESS_CACHE_VERSION%%";if(navigator.serviceWorker.getRegistrations)navigator.serviceWorker.getRegistrations().then(function(rs){var removed=false;return Promise.all(rs.map(function(r){var a=r.active||r.waiting||r.installing,s=a&&a.scriptURL||"";if(r.scope.indexOf("/odoo")!==-1||s.indexOf("/web/service-worker.js")!==-1)return r.unregister().then(function(ok){removed=removed||ok});return Promise.resolve()})).then(function(){if(removed&&!sessionStorage.getItem(K)){sessionStorage.setItem(K,"1");location.reload()}})});try{Object.defineProperty(navigator.serviceWorker,"controller",{get:function(){return C},configurable:true})}catch(e){};navigator.serviceWorker.register=function(){return Promise.resolve({scope:P+"/",installing:null,waiting:null,active:C,update:function(){return Promise.resolve()},unregister:function(){return Promise.resolve(true)},addEventListener:function(){},removeEventListener:function(){}})}}}catch(e){}})()</script>';
        }
    }
}
