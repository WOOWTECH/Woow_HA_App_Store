daemon off;
pid /var/run/nginx.pid;
worker_processes 1;
error_log /dev/stderr info;

events { worker_connections 1024; }

http {
    log_format safe '$remote_addr - $remote_user [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent "-" "$http_user_agent" xfo="$sent_http_x_frame_options" upstream_xfo="$upstream_http_x_frame_options" proto="$http_x_forwarded_proto" host="$http_host"';
    access_log /dev/stdout safe;
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }
    map $http_x_forwarded_proto $forwarded_proto {
        default $http_x_forwarded_proto;
        '' $scheme;
    }
    map $http_x_forwarded_proto $ingress_proto {
        default https;
        https https;
        http http;
    }
    map $ingress_proto $ingress_cookie_secure {
        https secure;
        default nosecure;
    }
    map $http_x_ingress_path $safe_ingress_path {
        default "";
        "~^/api/hassio_ingress/[A-Za-z0-9_-]{16,128}$" $http_x_ingress_path;
    }

    # `sub_filter_types` applies to every rule in a location. Keep the generic
    # ingress JSON URL rewrites enabled, but make the runtime shim itself a
    # content-type-aware replacement: embedded preview HTML in JSON must remain
    # JSON rather than receiving raw script bytes.
    #
    # The Runtime shim is two scripts. nginx reads a single quoted parameter
    # into a 4096-byte buffer and refuses the file ("too long parameter") when
    # one exceeds it; the prefix script below is close to that limit, so every
    # other part of the Runtime shim lives in its own map and is spliced into
    # `$ingress_runtime_shim` by variable reference, as the clipboard script
    # is. That keeps the text/html gate and the Ingress-only sub_filter as the
    # single injection point.
    #
    # Clipboard script (issue #60). Home Assistant opened over plain http on
    # the LAN is a supported usage, and that page is not a secure context, so
    # `navigator.clipboard` does not exist inside the Ingress iframe and every
    # Odoo copy button throws on `writeText`. When it is absent this defines
    # `writeText` over a temporary textarea and `document.execCommand("copy")`,
    # which still works without a secure context as long as it runs inside the
    # user's click, then hands focus back to the element that had it. A real
    # `navigator.clipboard` (HA over https) is never touched, and `write()`
    # stays absent so Odoo keeps its own error path for Blob payloads.
    map $upstream_http_content_type $ingress_clipboard_shim {
        default '<script>(function(){try{if(!navigator.clipboard){var CB={writeText:function(t){return new Promise(function(ok,no){var d=document,f=d.activeElement,ta=d.createElement("textarea"),done=false;ta.value=String(t);ta.setAttribute("readonly","");ta.setAttribute("aria-hidden","true");ta.style.position="fixed";ta.style.top="0";ta.style.left="0";ta.style.width="1px";ta.style.height="1px";ta.style.opacity="0";(d.body||d.documentElement).appendChild(ta);try{ta.select();if(ta.setSelectionRange)ta.setSelectionRange(0,ta.value.length);done=d.execCommand("copy")===true}catch(e){done=false}if(ta.parentNode)ta.parentNode.removeChild(ta);if(f&&f.focus)f.focus();if(done)ok();else no(new Error("clipboard write failed"))})}};try{Object.defineProperty(navigator,"clipboard",{value:CB,configurable:true,writable:true})}catch(e){navigator.clipboard=CB}}}catch(e){}})()</script>';
    }

    # Canonical URL script (issue #70). Odoo 18 builds some outbound links in
    # the browser, from the address in the address bar: the Discuss invitation
    # link is `window.location.origin` joined to `/chat/<id>/<uuid>`, and
    # `@web/core/utils/urls` falls back to the browser protocol and host
    # because Odoo 18 session info carries no origin. Through Ingress that
    # address is the Home Assistant host, so the link is useless to the person
    # it is sent to, and the lock the maintenance bootstrap puts on
    # web.base.url cannot reach it: the value never passes through the server.
    #
    # This publishes the Canonical URL to the page. It changes no address by
    # itself; each Literal rewrite that moves a browser-built outbound link
    # onto this base is added one exact expression at a time. An empty value
    # -- Ingress-only, with the Supervisor reporting no LAN address -- leaves
    # every one of them on the browser origin, which is today's behaviour.
    #
    # The global is read-only so a bundle cannot move the base of a link that
    # has already been rewritten, and it carries no trailing slash because
    # canonical_url() in the maintenance library strips one.
    map $upstream_http_content_type $ingress_canonical_url_shim {
        default '<script>(function(){var U="%%CANONICAL_URL%%";try{Object.defineProperty(window,"__WOOW_CANONICAL_URL__",{value:U,writable:false,configurable:false,enumerable:true})}catch(e){window.__WOOW_CANONICAL_URL__=U}})()</script>';
    }

    map $upstream_http_content_type $ingress_runtime_shim {
        default "";
        "~*^text/html(?:;|$)" '$ingress_clipboard_shim$ingress_canonical_url_shim<script>window.__INGRESS_PATH__="$safe_ingress_path";(function(){var P=window.__INGRESS_PATH__||"";if(!P)return;var path=function(u){if(typeof u!=="string")return u;if(u.charAt(0)==="#")return u;try{var x=new URL(u,location.href);if(x.origin===location.origin){var q=x.pathname+x.search+x.hash;while(q.indexOf(P+P)===0)q=q.slice(P.length);if(q.indexOf(P)===0)return q;if(q.charAt(0)==="/")return P+q}}catch(e){}return u};var F=window.fetch;window.fetch=function(i,o){if(typeof i==="string")i=path(i);else if(i instanceof URL)i=path(i.href);else if(i&&i.url){var u=path(i.url);if(u!==i.url)i=new Request(u,i)}return F(i,o)};var X=XMLHttpRequest.prototype.open;XMLHttpRequest.prototype.open=function(m,u){arguments[1]=path(u);return X.apply(this,arguments)};var H=function(fn){return function(s,t,u){if(typeof u==="string")arguments[2]=path(u);else if(u instanceof URL)arguments[2]=path(u.href);return fn.apply(this,arguments)}};var HP=History.prototype.pushState,HR=History.prototype.replaceState;History.prototype.pushState=H(HP);History.prototype.replaceState=H(HR);var A=Element.prototype.setAttribute;Element.prototype.setAttribute=function(n,v){if((n==="href"||n==="src"||n==="action")&&typeof v==="string")v=path(v);return A.call(this,n,v)};var prop=function(proto,n){if(!proto)return;var d=Object.getOwnPropertyDescriptor(proto,n);if(!d||!d.set)return;Object.defineProperty(proto,n,{get:d.get,set:function(v){return d.set.call(this,path(v))},configurable:true})};prop(window.HTMLAnchorElement&&HTMLAnchorElement.prototype,"href");prop(window.HTMLLinkElement&&HTMLLinkElement.prototype,"href");prop(window.HTMLScriptElement&&HTMLScriptElement.prototype,"src");prop(window.HTMLImageElement&&HTMLImageElement.prototype,"src");prop(window.HTMLImageElement&&HTMLImageElement.prototype,"srcset");prop(window.HTMLFormElement&&HTMLFormElement.prototype,"action");var O=window.open;window.open=function(u){if(typeof u==="string")arguments[0]=path(u);return O.apply(this,arguments)};var WK=window.Worker;if(WK){window.Worker=function(u,o){return new WK(path(String(u)),o)};window.Worker.prototype=WK.prototype}var SW=window.SharedWorker;if(SW){window.SharedWorker=function(u,o){return new SW(path(String(u)),o)};window.SharedWorker.prototype=SW.prototype}var W=window.WebSocket;window.WebSocket=function(u,p){var s=String(u),h=location.host;if(s.indexOf("ws://"+h)===0||s.indexOf("wss://"+h)===0){var x=new URL(s);if(x.pathname.indexOf(P)!==0)x.pathname=P+x.pathname;s=x.toString()}return p===undefined?new W(s):new W(s,p)};window.WebSocket.prototype=W.prototype;window.WebSocket.CONNECTING=W.CONNECTING;window.WebSocket.OPEN=W.OPEN;window.WebSocket.CLOSING=W.CLOSING;window.WebSocket.CLOSED=W.CLOSED;try{if(navigator.serviceWorker){var C={addEventListener:function(){},removeEventListener:function(){},postMessage:function(){}};var K="woow-odoo-sw-clean-%%INGRESS_CACHE_VERSION%%";if(navigator.serviceWorker.getRegistrations)navigator.serviceWorker.getRegistrations().then(function(rs){var removed=false;return Promise.all(rs.map(function(r){var a=r.active||r.waiting||r.installing,s=a&&a.scriptURL||"";if(r.scope.indexOf("/odoo")!==-1||s.indexOf("/web/service-worker.js")!==-1)return r.unregister().then(function(ok){removed=removed||ok});return Promise.resolve()})).then(function(){if(removed&&!sessionStorage.getItem(K)){sessionStorage.setItem(K,"1");location.reload()}})});try{Object.defineProperty(navigator.serviceWorker,"controller",{get:function(){return C},configurable:true})}catch(e){};navigator.serviceWorker.register=function(){return Promise.resolve({scope:P+"/",installing:null,waiting:null,active:C,update:function(){return Promise.resolve()},unregister:function(){return Promise.resolve(true)},addEventListener:function(){},removeEventListener:function(){}})}}}catch(e){}})()</script>';
    }

    # ---- Origin listener (8069): who is calling? ----
    # Docker preserves the real client address for traffic arriving on the
    # published host port, so the source address is what separates a trusted
    # LAN caller from the Cloudflare tunnel -- the tunnel always reaches this
    # listener from inside the add-on network. `geo` resolves by longest
    # prefix, so the hassio carve-out below overrides the broad RFC1918
    # ranges regardless of the order they are written in.
    geo $woow_lan_src {
        default             0;
        127.0.0.0/8         1;
        ::1/128             1;
        %%LAN_NETWORKS%%
        # The add-on network is where the Cloudflare tunnel reaches this
        # listener from. Carve it out explicitly: the configured ranges very
        # plausibly contain it -- 172.16.0.0/12 does -- and without this the
        # tunnel would inherit the LAN tier along with the database manager.
        #
        # This includes the bridge address 172.30.32.1. Host-networked add-ons
        # share it, and the Cloudflare tunnel is commonly one of them, so
        # traffic arriving from it is off-LAN even though it looks host-local.
        # Anything on the Home Assistant host that needs the full application
        # goes through the ingress panel.
        172.30.32.0/23      0;
        fd0c:ac1e:2100::/48 0;
    }

    # Stays empty unless public_url is configured, so an unconfigured
    # public_url can never promote an off-LAN caller past the gate.
    map $http_host $woow_public_host {
        default 0;
        %%PUBLIC_HOST_MAP%%
    }

    # lan-source + public-host decide the privilege tier on 8069.
    map $woow_lan_src$woow_public_host $woow_origin_gate {
        default "deny";
        "10"    "lan";
        "11"    "lan";
        "01"    "public";
    }

    # The tunnel is pinned to its configured scheme; the LAN keeps whatever
    # scheme it actually used. Marking a session cookie Secure over plain LAN
    # http means the browser never sends it back, which reads as a successful
    # login that immediately bounces to the login page.
    map $woow_origin_gate $woow_origin_proto {
        "public" %%PUBLIC_PROTO%%;
        default  $scheme;
    }
    map $woow_origin_proto $woow_origin_cookie_secure {
        "https" "secure";
        default "nosecure";
    }

    # The LAN reaches Odoo's RPC endpoint directly; the tunnel keeps the
    # policy filter in front of it.
    map $woow_origin_gate $woow_jsonrpc_upstream {
        "lan"   "127.0.0.1:8070";
        default "127.0.0.1:8071";
    }

    upstream odoo_http { server 127.0.0.1:8070; }
    upstream odoo_websocket { server 127.0.0.1:%%WS_PORT%%; }

    # Origin listener. Reached two ways: the Cloudflare tunnel, via the
    # add-on's hassio-network DNS name, and -- when the 8069 host port is
    # published -- directly from the LAN. The gate above decides which.
    server {
        listen 8069 default_server;
        client_max_body_size 512M;
        if ($woow_origin_gate = "deny") { return %%DENY_STATUS%%; }

        # Inherited by every location that does not set its own headers.
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $woow_origin_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_request_buffering off;
        proxy_read_timeout 720s;
        proxy_send_timeout 720s;

        # Database lifecycle stays off the public tunnel. The LAN is trusted,
        # so it reaches the same database manager the ingress panel exposes.
        location ^~ /web/database/ {
            if ($woow_origin_gate != "lan") { return 404; }
            proxy_pass http://odoo_http;
        }
        location = /xmlrpc/db {
            if ($woow_origin_gate != "lan") { return 404; }
            proxy_pass http://odoo_http;
        }
        location = /xmlrpc/2/db {
            if ($woow_origin_gate != "lan") { return 404; }
            proxy_pass http://odoo_http;
        }

        location = /jsonrpc {
            proxy_pass http://$woow_jsonrpc_upstream;
        }

        location = /websocket {
            proxy_pass http://odoo_websocket;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header X-Forwarded-Proto $woow_origin_proto;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_read_timeout 3600s;
        }

        location / {
            proxy_pass http://odoo_http;
            proxy_cookie_flags session_id $woow_origin_cookie_secure httponly samesite=lax;
        }
    }

    # Direct WebSocket origin. Odoo binds its gevent worker to loopback, so
    # without this listener the published 8072 host port refuses every
    # connection. Routing it through nginx also puts it behind the same tier
    # gate as 8069 instead of exposing the worker unfiltered, and it answers
    # for workers=0 too, where the upstream is the main HTTP worker.
    server {
        listen 8072 default_server;
        client_max_body_size 512M;
        if ($woow_origin_gate = "deny") { return %%DENY_STATUS%%; }

        location / {
            proxy_pass http://odoo_websocket;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header X-Forwarded-Proto $woow_origin_proto;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_read_timeout 3600s;
        }
    }

    # HA Supervisor Ingress adapter.
    server {
        listen 5691;
        absolute_redirect off;
        allow 172.30.32.2;
        deny all;
        client_max_body_size 512M;

        location = /websocket {
            proxy_pass http://odoo_websocket;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $http_host;
            proxy_set_header Origin $ingress_proto://$http_host;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header X-Forwarded-Proto $ingress_proto;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_read_timeout 3600s;
        }

        # Rewrite route literals only in Odoo asset bundles. Applying these
        # substitutions to HTML would alter hidden login redirect values and
        # make nginx prepend the ingress token twice.
        location ^~ /web/assets/ {
            proxy_pass http://odoo_http;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header X-Forwarded-Proto $ingress_proto;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header Accept-Encoding "";
            proxy_buffering off;
            proxy_hide_header Cache-Control;
            proxy_hide_header Expires;
            proxy_hide_header ETag;
            add_header Cache-Control "no-store, no-cache, must-revalidate" always;

            sub_filter_once off;
            sub_filter_types application/javascript text/javascript text/css;
            sub_filter 'url(/' 'url($safe_ingress_path/';
            sub_filter "url('/" "url('$safe_ingress_path/";
            sub_filter 'url("/' 'url("$safe_ingress_path/';
            sub_filter '"/web/' '"$safe_ingress_path/web/';
            sub_filter "'/web/" "'$safe_ingress_path/web/";
            sub_filter '`/web/' '`$safe_ingress_path/web/';
            sub_filter '"/website/' '"$safe_ingress_path/website/';
            sub_filter "'/website/" "'$safe_ingress_path/website/";
            sub_filter '`/website/' '`$safe_ingress_path/website/';
            sub_filter '"/mail/' '"$safe_ingress_path/mail/';
            sub_filter "'/mail/" "'$safe_ingress_path/mail/";
            sub_filter '`/mail/' '`$safe_ingress_path/mail/';
            sub_filter '"/calendar/' '"$safe_ingress_path/calendar/';
            sub_filter "'/calendar/" "'$safe_ingress_path/calendar/";
            sub_filter '`/calendar/' '`$safe_ingress_path/calendar/';
            sub_filter '"/base_setup/' '"$safe_ingress_path/base_setup/';
            sub_filter "'/base_setup/" "'$safe_ingress_path/base_setup/";
            sub_filter '`/base_setup/' '`$safe_ingress_path/base_setup/';
            sub_filter '"/my/' '"$safe_ingress_path/my/';
            sub_filter "'/my/" "'$safe_ingress_path/my/";
            sub_filter '`/my/' '`$safe_ingress_path/my/';
            sub_filter '"/report/' '"$safe_ingress_path/report/';
            # Prefixes the Literal rewrite gate found in whole-page
            # navigations once the parity plan's 25 apps were installed
            # (issue #58): website_sale's redirect('/shop/cart'), the
            # payment flow's window.location='/payment/status', and a
            # website tour's window.location.href='/contactus'.
            sub_filter '"/shop/' '"$safe_ingress_path/shop/';
            sub_filter "'/shop/" "'$safe_ingress_path/shop/";
            sub_filter '`/shop/' '`$safe_ingress_path/shop/';
            sub_filter '"/payment/' '"$safe_ingress_path/payment/';
            sub_filter "'/payment/" "'$safe_ingress_path/payment/";
            sub_filter '`/payment/' '`$safe_ingress_path/payment/';
            sub_filter '"/contactus' '"$safe_ingress_path/contactus';
            sub_filter "'/contactus" "'$safe_ingress_path/contactus";
            sub_filter '`/contactus' '`$safe_ingress_path/contactus';
            # SettingsViewCompiler synthesizes each module fallback icon in the
            # web asset bundle. Prefix only that exact expression; a generic
            # module/static rewrite would affect unrelated application code.
            sub_filter 'imgurl:el.getAttribute("logo")||"/"+el.getAttribute("name")+"/static/description/icon.png"' 'imgurl:el.getAttribute("logo")||"$safe_ingress_path/"+el.getAttribute("name")+"/static/description/icon.png"';
            sub_filter '"/odoo' '"$safe_ingress_path/odoo';
            sub_filter "'/odoo" "'$safe_ingress_path/odoo";
            sub_filter '`/odoo' '`$safe_ingress_path/odoo';
            sub_filter 'scope:"/odoo"' 'scope:"$safe_ingress_path/odoo"';
            # Odoo's router only recognizes paths beginning /odoo. Parse a
            # cloned URL without the HA token prefix so history callers retain
            # their original ingress-prefixed URL.
            sub_filter 'function urlToState(urlObj){const{pathname,hash,search}=urlObj;' 'function urlToState(urlObj){if("$safe_ingress_path"&&urlObj.pathname.indexOf("$safe_ingress_path/")===0){urlObj=new URL(urlObj);urlObj.pathname=urlObj.pathname.slice("$safe_ingress_path".length)}const{pathname,hash,search}=urlObj;';
            sub_filter 'browser.location.host===url.host&&browser.location.pathname.startsWith("/odoo")&&(["/web","/odoo"].includes(url.pathname)||url.pathname.startsWith("/odoo/"))&&ev.target.target!=="_blank"){ev.preventDefault();state=router.urlToState(url);if(url.pathname.startsWith("/odoo")&&url.hash)' 'browser.location.host===url.host&&(browser.location.pathname==="$safe_ingress_path/odoo"||browser.location.pathname.startsWith("$safe_ingress_path/odoo/"))&&(["$safe_ingress_path/web","$safe_ingress_path/odoo"].includes(url.pathname)||url.pathname.startsWith("$safe_ingress_path/odoo/"))&&ev.target.target!=="_blank"){ev.preventDefault();state=router.urlToState(url);if((url.pathname==="$safe_ingress_path/odoo"||url.pathname.startsWith("$safe_ingress_path/odoo/"))&&url.hash)';
            sub_filter 'browser.location.origin+router.stateToUrl' 'browser.location.origin+"$safe_ingress_path"+router.stateToUrl';
            # Keep params.serverURL equal to window.origin so Odoo creates a
            # normal same-origin SharedWorker (not a data: URL worker). Prefix
            # only the worker script and WebSocket endpoint expressions.
            sub_filter 'params.serverURL}/bus/websocket_worker_bundle' 'params.serverURL}$safe_ingress_path/bus/websocket_worker_bundle';
            sub_filter 'serverURL.replace("http", "ws")}/websocket' 'serverURL.replace("http", "ws")}$safe_ingress_path/websocket';
            # SharedWorkers are keyed by origin and name. Version both the
            # worker identity and imported bundle so an open browser cannot
            # reuse a pre-upgrade worker that still targets root /websocket.
            sub_filter '"odoo:websocket_shared_worker"' '"odoo:websocket_shared_worker_%%INGRESS_CACHE_VERSION%%"';
            sub_filter '"odoo:websocket_worker"' '"odoo:websocket_worker_%%INGRESS_CACHE_VERSION%%"';
            sub_filter 'websocket_worker_bundle?v=' 'websocket_worker_bundle?woow_ingress=%%INGRESS_CACHE_VERSION%%&v=';
            # Links the browser builds for somebody outside to open (issue
            # #70, ADR 0006). These are absolute addresses, built in the page
            # from whatever is in the address bar, so under Ingress they carry
            # the Home Assistant host -- and, for the share snippet, the
            # Ingress token itself. The Runtime shim publishes the Canonical
            # URL as __WOOW_CANONICAL_URL__; each rule below moves one link
            # onto that base and falls back to the browser origin when the
            # global is empty, which is the behaviour without a Canonical URL.
            #
            # Every pattern is one exact expression, measured against the
            # bundles this add-on's control group actually serves with the
            # parity plan's 25 applications installed: each occurs exactly
            # once per bundle and nowhere near an in-Ingress address. The
            # bytes are kept as fixtures under tests/fixtures/bundles/ --
            # an unmatched sub_filter is a silent no-op, so a rule written
            # from a guess would never turn a test red.
            #
            # Discuss invitation link: `${window.location.origin}/chat/<id>/<uuid>`.
            # /chat/ appears nowhere else in any served bundle.
            sub_filter 'window.location.origin}/chat/' 'window.__WOOW_CANONICAL_URL__||window.location.origin}/chat/';
            # Website page URL field: the base shown before the page path in
            # the backend form (`this.serverUrl`), a display value only. The
            # pattern carries the closing backtick and the semicolon, so it
            # matches a template literal that is the whole statement and not
            # an origin spliced into a larger in-Ingress URL.
            sub_filter 'window.location.origin}/`;' 'window.__WOOW_CANONICAL_URL__||window.location.origin}/`;';
            # Website share snippet (.s_share, .oe_share): the current page
            # address handed to Facebook, X, WhatsApp and the rest. This one
            # needs the path as well as the base, because under Ingress
            # location.href carries the Supervisor token and posting it to a
            # social network publishes it.
            #
            # The Ingress prefix is dropped whether or not a Canonical URL
            # exists -- this rule is the one exception to "no Canonical URL
            # means today's behaviour" (ADR 0006), because here today's
            # behaviour hands a Supervisor token to a third party. Without a
            # Canonical URL the link keeps the browser origin, so it is as
            # broken as it was, but it no longer carries the token.
            sub_filter 'const currentUrl=window.location.href;' 'const currentUrl=(function(){var L=window.location,B=window.__WOOW_CANONICAL_URL__||L.origin,P="$safe_ingress_path",p=L.pathname;if(P&&p.indexOf(P)===0)p=p.slice(P.length)||"/";return B+p+L.search+L.hash})();';
            # Generated rewrites (ADR 0005). The add-on writes this file from
            # its own Rewrite scan; the config-rendering init step creates it
            # empty so a fresh install starts. It holds prefix rules only, and
            # never a prefix the rules above already cover, so the two sets
            # never compete for the same literal -- which matters because
            # sub_filter resolves overlapping patterns by its own match table
            # and not by the order the rules are written in.
            include /data/nginx-generated-rewrites.conf;
        }

        location / {
            proxy_pass http://odoo_http;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header X-Forwarded-Proto $ingress_proto;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header Accept-Encoding "";
            # Odoo backend responses use X-Frame-Options: DENY, which makes
            # the authenticated /odoo document fail before any assets load in
            # Home Assistant's ingress iframe. HA session auth is the frame
            # boundary, so remove this header only on the ingress listener.
            proxy_hide_header X-Frame-Options;
            proxy_request_buffering off;
            proxy_buffering off;
            proxy_read_timeout 720s;
            proxy_send_timeout 720s;

            proxy_redirect ~^(?<odoo_redirect>/.*)$ $safe_ingress_path$odoo_redirect;
            proxy_cookie_path / $safe_ingress_path/;
            proxy_cookie_flags session_id $ingress_cookie_secure httponly samesite=lax;

            sub_filter_once off;
            sub_filter_types application/javascript text/javascript text/css application/json;
            sub_filter 'href="/' 'href="$safe_ingress_path/';
            sub_filter 'src="/' 'src="$safe_ingress_path/';
            sub_filter 'action="/' 'action="$safe_ingress_path/';
            sub_filter 'data-src="/' 'data-src="$safe_ingress_path/';
            sub_filter 'srcset="/' 'srcset="$safe_ingress_path/';
            # Rewritten asset bytes change with ingress releases while Odoo's
            # content hash does not. Cache-bust HTML references so clients do
            # not keep an older transformed bundle after an add-on update.
            sub_filter '.min.js"' '.min.js?woow_ingress=%%INGRESS_CACHE_VERSION%%"';
            sub_filter '.min.css"' '.min.css?woow_ingress=%%INGRESS_CACHE_VERSION%%"';
            sub_filter '&#39;/web/login&#39;' '&#39;$safe_ingress_path/web/login&#39;';
            sub_filter '"translationURL": "/website/' '"translationURL": "$safe_ingress_path/website/';
            # /web/bundle returns JSON objects such as {"src": "/web/assets/..."}.
            # The Website editor may inject those assets into a child iframe
            # whose DOM prototypes are outside the parent runtime shim.
            sub_filter '"src": "/' '"src": "$safe_ingress_path/';
            # Document Layout serializes its preview HTML into JSON, escaping
            # attributes as href=\"...\"/src=\"...\". Prefix only root Odoo
            # assets in those JSON bytes; broad JSON rewriting is unsafe.
            sub_filter 'href=\\"/web/assets/' 'href=\\"$safe_ingress_path/web/assets/';
            sub_filter 'src=\\"/web/assets/' 'src=\\"$safe_ingress_path/web/assets/';
            sub_filter '"icon":"/' '"icon":"$safe_ingress_path/';
            sub_filter '"icon": "/' '"icon": "$safe_ingress_path/';
            sub_filter '"imgurl":"/' '"imgurl":"$safe_ingress_path/';
            sub_filter '"imgurl": "/' '"imgurl": "$safe_ingress_path/';
            # General Settings embeds this exact logo path in get_views XML.
            # Match the path itself so surrounding XML/JSON quote escaping does
            # not affect the ingress-only replacement.
            sub_filter '/base/static/description/settings.png' '$safe_ingress_path/base/static/description/settings.png';
            sub_filter '`/web/webclient/' '`$safe_ingress_path/web/webclient/';
            sub_filter 'url(/' 'url($safe_ingress_path/';
            sub_filter "url('/" "url('$safe_ingress_path/";
            sub_filter 'url("/' 'url("$safe_ingress_path/';

            sub_filter '<head>' '<head>$ingress_runtime_shim';
        }
    }
}
