            # a way it wraps.
            sub_filter 'url({{snippet.thumbnailSrc}})' "url({{(snippet.thumbnailSrc+'').indexOf('/')===0?'$safe_ingress_path'+snippet.thumbnailSrc:snippet.thumbnailSrc}})";
            # Generated rewrites (ADR 0005). The add-on writes this file from
            # its own Rewrite scan; the config-rendering init step creates it
            # empty so a fresh install starts. It holds prefix rules only, and
            # never a prefix the rules above already cover, so the two sets
            # never compete for the same literal. That is a rule about what is
            # generated and not a property of nginx: measured on 1.22.1, two
            # sub_filter patterns that match at the same byte are settled by
            # the order they are written, the earlier one winning even where a
            # later one is longer (issue #158 depends on that, and pins it).
            # The no-overlap rule stays, because the order between a hand-
            # written rule here and a machine-written one inside the include is
