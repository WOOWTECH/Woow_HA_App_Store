            # data-success-mode="redirect" data-success-page="/contactus-thank-you"
            # on Contact Us, "/job-thank-you" on a job application, whatever the
            # user chose on a form built in the editor -- and the form script
            # assigns that root-relative path to the page location once the
            # submit RPC answers. The five rules above are the only attributes
            # rewritten here, the Runtime shim wraps no location assignment (ADR
            # 0004 records that as a decision, not an omission), and the Rewrite
            # scan reads asset bundles and not page HTML, so the value reached
            # the browser bare: the record was created and then the thank-you
            # page was asked of the Home Assistant root, which answered 404
            # (issue #167). The rule belongs to the attribute and not to any one
            # form or path, so it covers every website form on every page. A
            # value that is a same-page anchor (`#thanks`) or an absolute URL
            # matches no byte of it and is left alone.
            #
            # `data-success_page` with an underscore is the same value in the
            # arch a form saved before Odoo 14 left behind, and Odoo 18 still
            # reads it: the script above falls back to it whenever
            # `data-success-mode` is absent. An upgraded database keeps forms in
            # that shape, so the compatibility spelling gets the same rule
            # rather than the same 404.
            #
            # These two inherit the protocol-relative limit of the five rules
            # above -- a plain-string pattern prefixes `//host/path` too, and
            # breaks it -- and here that limit is not covered by "Odoo writes
            # none": the value is what the person editing the form typed into
            # the redirect field. It is still one shape among the file's, fixed
            # for every such rule at once or not at all (issue #166).
            sub_filter 'data-success-page="/' 'data-success-page="$safe_ingress_path/';
            sub_filter 'data-success_page="/' 'data-success_page="$safe_ingress_path/';
            # Rewritten asset bytes change with ingress releases while Odoo's
            # content hash does not. Cache-bust HTML references so clients do
            # not keep an older transformed bundle after an add-on update.
            sub_filter '.min.js"' '.min.js?woow_ingress=%%INGRESS_CACHE_VERSION%%"';
            sub_filter '.min.css"' '.min.css?woow_ingress=%%INGRESS_CACHE_VERSION%%"';
            sub_filter '&#39;/web/login&#39;' '&#39;$safe_ingress_path/web/login&#39;';
            sub_filter '"translationURL": "/website/' '"translationURL": "$safe_ingress_path/website/';
            # /web/bundle returns JSON objects such as {"src": "/web/assets/..."}.
            # The Website editor may inject those assets into a child iframe
            # whose DOM prototypes are outside the parent runtime shim.
            sub_filter '"src": "/' '"src": "$safe_ingress_path/';
            # Document Layout serializes its preview HTML into JSON, escaping
            # attributes as href=\"...\"/src=\"...\". Prefix only root Odoo
            # assets in those JSON bytes; broad JSON rewriting is unsafe.
            sub_filter 'href=\\"/web/assets/' 'href=\\"$safe_ingress_path/web/assets/';
            sub_filter 'src=\\"/web/assets/' 'src=\\"$safe_ingress_path/web/assets/';
            sub_filter '"icon":"/' '"icon":"$safe_ingress_path/';
            sub_filter '"icon": "/' '"icon": "$safe_ingress_path/';
            sub_filter '"imgurl":"/' '"imgurl":"$safe_ingress_path/';
            sub_filter '"imgurl": "/' '"imgurl": "$safe_ingress_path/';
            # General Settings embeds this exact logo path in get_views XML.
            # Match the path itself so surrounding XML/JSON quote escaping does
            # not affect the ingress-only replacement.
            sub_filter '/base/static/description/settings.png' '$safe_ingress_path/base/static/description/settings.png';
