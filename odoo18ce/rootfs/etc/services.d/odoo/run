#!/usr/bin/with-contenv bashio
# ==============================================================================
# Start Odoo 18 — waits for PG, auto-creates DB if needed,
# runs auto-update if configured, then starts
# ==============================================================================

# ---------- 1. Wait for PostgreSQL to be ready (max 30 s) ----------
bashio::log.info "Waiting for PostgreSQL to become ready..."
for i in $(seq 1 30); do
    if pg_isready -h 127.0.0.1 -p 5432 -U odoo -q; then
        bashio::log.info "PostgreSQL is ready"
        break
    fi
    if [ "${i}" -eq 30 ]; then
        bashio::log.error "PostgreSQL did not become ready in 30 seconds"
        exit 1
    fi
    sleep 1
done

# ---------- 2. Auto-create database if default_db is set ----------
if bashio::config.has_value 'default_db'; then
    DB_NAME=$(bashio::config 'default_db')
    if [ -n "${DB_NAME}" ]; then
        # Check if DB already exists (use local socket = trust auth)
        DB_EXISTS=$(s6-setuidgid postgres psql -tAc \
            "SELECT 1 FROM pg_database WHERE datname='${DB_NAME}'" 2>/dev/null || echo "")

        if [ "${DB_EXISTS}" != "1" ]; then
            bashio::log.info "Database '${DB_NAME}' not found, initializing..."
            if ! s6-setuidgid odoo /usr/bin/odoo \
                -c /data/odoo.conf \
                -d "${DB_NAME}" \
                --init base \
                --without-demo=all \
                --stop-after-init; then
                bashio::log.error "Database initialization failed for: ${DB_NAME}"
                exit 1
            fi
            bashio::log.info "Database '${DB_NAME}' initialized"
        fi
    fi
fi

# ---------- 3. Auto-update modules if configured ----------
if bashio::config.has_value 'auto_update_module'; then
    MODULE=$(bashio::config 'auto_update_module')
    if [ -n "${MODULE}" ]; then
        if ! bashio::config.has_value 'default_db' || [ -z "$(bashio::config 'default_db')" ]; then
            bashio::log.error "default_db is required when auto_update_module is configured"
            exit 1
        fi
        bashio::log.info "Running module update: ${MODULE}"
        if ! s6-setuidgid odoo \
            /usr/bin/odoo \
                -c /data/odoo.conf \
                -u "${MODULE}" \
                --stop-after-init; then
            bashio::log.error "Module update failed for: ${MODULE}"
            exit 1
        fi
        bashio::log.info "Module update complete"
    fi
fi

# ---------- 4. Canonical URL and optional one-shot maintenance user ----------
if ! /usr/local/bin/odoo-maintenance-bootstrap /data/odoo.conf; then
    bashio::log.error "Odoo maintenance bootstrap failed"
    exit 1
fi

# ---------- 5. Start Odoo ----------
bashio::log.info "Starting Odoo 18..."
exec s6-setuidgid odoo \
    /usr/bin/odoo \
        -c /data/odoo.conf
