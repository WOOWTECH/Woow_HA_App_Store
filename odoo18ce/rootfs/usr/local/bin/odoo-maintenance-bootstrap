#!/usr/bin/with-contenv bashio
# ==============================================================================
# odoo-maintenance-bootstrap
# Runs once per add-on start, after PostgreSQL is up and before Odoo serves
# requests. For every Odoo database it writes and locks the Canonical URL
# (web.base.url + web.base.url.freeze) and mirrors it into the default
# website's domain; see /usr/local/lib/odoo-maintenance.py for the rules.
# Then, only in default_db, it applies the one-shot bootstrap-user.json.
#
# Exit status: non-zero only for a bootstrap-user.json policy violation. A
# failure inside one database is logged and the pass moves on, so Odoo
# always starts.
# ==============================================================================
set -euo pipefail

CONF="${1:-/data/odoo.conf}"
BOOTSTRAP_FILE="/config/bootstrap-user.json"
MAINT_LIB="/usr/local/lib/odoo-maintenance.py"
ACCOUNT_LIB="/usr/local/lib/odoo-maintenance-account.py"

DB_NAME=""
if bashio::config.has_value 'default_db'; then
    DB_NAME="$(bashio::config 'default_db')"
fi

PUBLIC_URL=""
if bashio::config.has_value 'public_url'; then
    PUBLIC_URL="$(bashio::config 'public_url')"
fi

# ---------- 1. bootstrap-user.json policy (the only fatal errors) ----------
TEST_LOGIN=""
TEST_PASSWORD=""
TEST_ADMIN="false"
if [ -e "${BOOTSTRAP_FILE}" ]; then
    if [ -L "${BOOTSTRAP_FILE}" ] || [ ! -f "${BOOTSTRAP_FILE}" ]; then
        bashio::log.error "bootstrap-user.json must be a regular non-symlink file"
        exit 1
    fi
    FILE_POLICY="$(stat -c '%U:%a' "${BOOTSTRAP_FILE}")"
    if [ "${FILE_POLICY}" != "root:600" ]; then
        bashio::log.error "bootstrap-user.json must be owned by root with mode 0600"
        exit 1
    fi
    TEST_LOGIN="$(jq -er '.login' "${BOOTSTRAP_FILE}")"
    TEST_PASSWORD="$(jq -er '.password' "${BOOTSTRAP_FILE}")"
    TEST_ADMIN="$(jq -r '.admin // false' "${BOOTSTRAP_FILE}")"
    if [ "${#TEST_PASSWORD}" -lt 20 ]; then
        bashio::log.error "bootstrap-user.json password must contain at least 20 characters"
        exit 1
    fi
fi

# ---------- 2. Canonical URL inputs ----------
# Without public_url the Canonical URL is the host's LAN address with the
# published Odoo port. Both are what cont-init settled on this start and
# published as WOOW_LAN_IPV4 and WOOW_LAN_PORT under WOOW_CANONICAL_SETTLED=1
# (issue #108): it waited for the Supervisor there and already said so when
# nothing came, and this side reuses the answer rather than asking again, so
# one start has one address and one port on both sides (ADR 0006). This
# script never asks the Supervisor itself: with no marker there is no LAN
# address this start, because a second derivation is what ADR 0006 forbids.
LAN_IPV4=""
PUBLISHED_PORT=""
if [ -z "${PUBLIC_URL}" ]; then
    if [ "${WOOW_CANONICAL_SETTLED:-}" = 1 ]; then
        LAN_IPV4="${WOOW_LAN_IPV4:-}"
        PUBLISHED_PORT="${WOOW_LAN_PORT:-}"
    else
        bashio::log.warning "maintenance: cont-init published no settled Canonical URL inputs this start (it did not settle them, or could not publish them); no LAN address is used"
    fi
fi

export ODOO_MAINT_PUBLIC_URL="${PUBLIC_URL}"
export ODOO_MAINT_LAN_IPV4="${LAN_IPV4}"
export ODOO_MAINT_PORT="${PUBLISHED_PORT}"

# ---------- 3. Canonical URL, every Odoo database ----------
# Every database owned by the odoo role that carries ir_config_parameter is
# an Odoo database. postgres and the templates are never listed.
psql_as_postgres() {
    s6-setuidgid postgres psql -v ON_ERROR_STOP=1 -tA "$@"
}

# Forward the lib's "maintenance db=<name>: ..." lines at the right level.
log_maintenance_lines() {
    local line
    while IFS= read -r line; do
        [ -n "${line}" ] || continue
        case "${line}" in
            *WARNING*) bashio::log.warning "${line}" ;;
            *) bashio::log.info "${line}" ;;
        esac
    done
}

DATABASES=()
if DB_LIST="$(psql_as_postgres -c "
        SELECT datname FROM pg_database
        WHERE NOT datistemplate AND datallowconn
          AND datname <> 'postgres'
          AND pg_get_userbyid(datdba) = 'odoo'
        ORDER BY datname")"; then
    if [ -n "${DB_LIST}" ]; then
        mapfile -t DATABASES <<< "${DB_LIST}"
    else
        bashio::log.info "No Odoo database yet; the Canonical URL is applied on the next start"
    fi
else
    bashio::log.error "maintenance: PostgreSQL databases could not be listed; no Canonical URL was written this start"
fi

for DB in "${DATABASES[@]}"; do
    IS_ODOO="$(psql_as_postgres -d "${DB}" \
        -c "SELECT to_regclass('public.ir_config_parameter') IS NOT NULL" 2>/dev/null || echo f)"
    if [ "${IS_ODOO}" != "t" ]; then
        bashio::log.info "maintenance db=${DB}: not an Odoo database, skipped"
        continue
    fi
    if OUTPUT="$(ODOO_MAINT_DB="${DB}" s6-setuidgid odoo /usr/bin/odoo shell \
            -c "${CONF}" -d "${DB}" --no-http < "${MAINT_LIB}")"; then
        log_maintenance_lines <<< "${OUTPUT}"
    else
        log_maintenance_lines <<< "${OUTPUT}"
        bashio::log.error "maintenance db=${DB}: Canonical URL pass failed; see the traceback above"
    fi
done

# ---------- 4. One-shot maintenance account, default_db only ----------
if [ -n "${TEST_LOGIN}" ]; then
    if [ -z "${DB_NAME}" ]; then
        bashio::log.warning "bootstrap-user.json is present but default_db is unset; the account is skipped and the file is kept for the next start"
    else
        export ODOO_MAINT_USER_LOGIN="${TEST_LOGIN}"
        export ODOO_MAINT_USER_PASSWORD="${TEST_PASSWORD}"
        export ODOO_MAINT_USER_ADMIN="${TEST_ADMIN}"
        bashio::log.info "Applying the maintenance account in ${DB_NAME}..."
        if s6-setuidgid odoo /usr/bin/odoo shell \
                -c "${CONF}" -d "${DB_NAME}" --no-http < "${ACCOUNT_LIB}"; then
            rm -f "${BOOTSTRAP_FILE}"
            bashio::log.info "One-shot Odoo maintenance account file consumed"
        else
            bashio::log.error "maintenance account could not be written in ${DB_NAME}; the file is kept for the next start"
        fi
    fi
fi

exit 0
