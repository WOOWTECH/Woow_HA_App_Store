#!/usr/bin/with-contenv bashio
# shellcheck shell=bash

set +eu

# ---------------------------------------------------------------------------
# WOOWTECH: Read db_password from HA options and override defaults
# ---------------------------------------------------------------------------
OPTIONS_FILE="/data/options.json"
if [[ -f "${OPTIONS_FILE}" ]]; then
    OPT_DB_PASS=$(jq -r '.db_password // empty' "${OPTIONS_FILE}")
    if [[ -n "${OPT_DB_PASS}" ]]; then
        export DB_PASS="${OPT_DB_PASS}"
        export POSTGRES_PASSWORD="${OPT_DB_PASS}"
    fi

    OPT_ADMIN_USER=$(jq -r '.ADMIN_USER // empty' "${OPTIONS_FILE}")
    if [[ -n "${OPT_ADMIN_USER}" ]]; then
        export ADMIN_USER="${OPT_ADMIN_USER}"
    fi

    OPT_ADMIN_PASS=$(jq -r '.ADMIN_PASS // empty' "${OPTIONS_FILE}")
    if [[ -n "${OPT_ADMIN_PASS}" ]]; then
        export ADMIN_PASS="${OPT_ADMIN_PASS}"
    fi

    OPT_DATADIR=$(jq -r '.NEXTCLOUD_DATADIR // empty' "${OPTIONS_FILE}")
    if [[ -n "${OPT_DATADIR}" ]]; then
        export NEXTCLOUD_DATADIR="${OPT_DATADIR}"
    fi

    OPT_TZ=$(jq -r '.TZ // empty' "${OPTIONS_FILE}")
    if [[ -n "${OPT_TZ}" ]]; then
        export TZ="${OPT_TZ}"
    fi

    OPT_OVERWRITEPROTOCOL=$(jq -r '.OVERWRITEPROTOCOL // empty' "${OPTIONS_FILE}")
    if [[ -n "${OPT_OVERWRITEPROTOCOL}" ]]; then
        export OVERWRITEPROTOCOL="${OPT_OVERWRITEPROTOCOL}"
    fi

    OPT_OVERWRITEHOST=$(jq -r '.OVERWRITEHOST // empty' "${OPTIONS_FILE}")
    if [[ -n "${OPT_OVERWRITEHOST}" ]]; then
        export OVERWRITEHOST="${OPT_OVERWRITEHOST}"
    fi

    OPT_OVERWRITECLIURL=$(jq -r '.OVERWRITECLIURL // empty' "${OPTIONS_FILE}")
    if [[ -n "${OPT_OVERWRITECLIURL}" ]]; then
        export OVERWRITECLIURL="${OPT_OVERWRITECLIURL}"
    fi

    OPT_DEFAULT_PHONE_REGION=$(jq -r '.DEFAULT_PHONE_REGION // empty' "${OPTIONS_FILE}")
    if [[ -n "${OPT_DEFAULT_PHONE_REGION}" ]]; then
        export DEFAULT_PHONE_REGION="${OPT_DEFAULT_PHONE_REGION}"
    fi

    # SMTP settings
    for key in SMTP_HOST SMTP_SECURE SMTP_PORT SMTP_AUTH SMTP_AUTHTYPE SMTP_USER SMTP_PASS MAIL_FROM_ADDRESS MAIL_DOMAIN; do
        val=$(jq -r ".${key} // empty" "${OPTIONS_FILE}")
        if [[ -n "${val}" ]]; then
            export "${key}=${val}"
        fi
    done

    # Custom environment variables from env_vars array
    mapfile -t ENV_KEYS < <(jq -r '.env_vars[]? | .key // empty' "${OPTIONS_FILE}")
    mapfile -t ENV_VALS < <(jq -r '.env_vars[]? | .value // empty' "${OPTIONS_FILE}")
    for i in "${!ENV_KEYS[@]}"; do
        if [[ -n "${ENV_KEYS[$i]}" ]]; then
            export "${ENV_KEYS[$i]}=${ENV_VALS[$i]}"
        fi
    done
fi

# ---------------------------------------------------------------------------
# WOOWTECH: Wait for PostgreSQL to be ready
# ---------------------------------------------------------------------------
echo "Waiting for PostgreSQL to be ready..."
RETRIES=60
until pg_isready -U "${POSTGRES_USER:-nextcloud}" -h localhost -q 2>/dev/null; do
    RETRIES=$((RETRIES - 1))
    if [[ ${RETRIES} -le 0 ]]; then
        echo "ERROR: PostgreSQL failed to start within 60 seconds"
        exit 1
    fi
    sleep 1
done
echo "PostgreSQL is ready"

# Ensure the nextcloud database exists (in case initdb didn't create it)
# Note: initdb creates POSTGRES_USER as the superuser, so we must use -U to specify it
if ! s6-setuidgid postgres psql -U "${POSTGRES_USER:-nextcloud}" -lqt 2>/dev/null | cut -d \| -f 1 | grep -qw "${POSTGRES_DB:-nextcloud}"; then
    echo "Creating database ${POSTGRES_DB:-nextcloud}..."
    s6-setuidgid postgres createdb -U "${POSTGRES_USER:-nextcloud}" -O "${POSTGRES_USER:-nextcloud}" "${POSTGRES_DB:-nextcloud}" 2>/dev/null || true
fi

# create folders
mkdir -p \
    /app/www/public \
    /config/www/nextcloud/apps \
    /config/www/nextcloud/custom_apps \
    /config/www/nextcloud/config \
    /config/www/nextcloud/themes \
    "${NEXTCLOUD_DATADIR}"

# migrate legacy install (copy inside container)
if [[ -f /config/www/nextcloud/version.php ]]; then
    echo "Migrating legacy install (this can take a while) ...)"
    rsync -rlD --remove-source-files --exclude-from=/app/upgrade.exclude /config/www/nextcloud/ /app/www/public/
    rm -rf /config/www/nextcloud/updater/
    find \
        /config/www/nextcloud/ \
        -type d -empty \
        ! -path "/config/www/nextcloud/apps" \
        ! -path "/config/www/nextcloud/config" \
        ! -path "/config/www/nextcloud/themes" \
        -delete
    touch /config/www/nextcloud/config/needs_migration
fi

# symlink config folders
for dir in apps config themes; do
    if [[ "$(readlink /app/www/public/${dir})" != "/config/www/nextcloud/${dir}" ]]; then
        rm -rf "/app/www/public/${dir}"
        ln -s "/config/www/nextcloud/${dir}" "/app/www/public/${dir}"
        lsiown abc:abc "/config/www/nextcloud/${dir}" "/app/www/public/${dir}"
    fi
done

# set data directory
if [[ ! -s /config/www/nextcloud/config/config.php ]]; then
    touch /config/www/nextcloud/config/CAN_INSTALL
    echo -e "<?php\n\$CONFIG = array (\n    'datadirectory' => '$NEXTCLOUD_DATADIR',\n);" >/config/www/nextcloud/config/config.php
elif [[ -f /config/www/nextcloud/config/config.php ]]; then
    sed -i "s|/app/www/public/data|$NEXTCLOUD_DATADIR|g" /config/www/nextcloud/config/config.php
fi

#modify javascript mime type and add .mjs support
if [[ -s /etc/nginx/mime.types ]]; then
    sed -i 's|\bjs;|js mjs;|g' /etc/nginx/mime.types
    sed -i 's|\bapplication/javascript|text/javascript|g' /etc/nginx/mime.types
fi

# get versions
image_version=$(php -r "require '/app/www/src/version.php'; echo implode('.', \$OC_Version);" 2>/dev/null | xargs)
installed_version=$(php -r "require '/config/www/nextcloud/config/config.php'; echo \$CONFIG['version'];" 2>/dev/null | xargs)
if [[ "${installed_version}" = "" ]]; then
    installed_version="0.0.0.0"
fi
image_major="${image_version%%.*}"
installed_major="${installed_version%%.*}"
((max_upgrade = installed_major + 1))

# compare versions
vergte() { printf '%s\n%s' "${2}" "${1}" | sort -C -V; }
vergt() { ! vergte "${2}" "${1}"; }
verlte() { printf '%s\n%s' "${1}" "${2}" | sort -C -V; }
verlt() { ! verlte "${2}" "${1}"; }

if vergt "${installed_version}" "${image_version}"; then
    echo "Can't start Nextcloud because the version of the data (${installed_version}) is higher than the docker image version (${image_version}) and downgrading is not supported. Are you sure you have pulled the newest image version?"
    sleep infinity
fi

if [[ "${installed_version}" != "0.0.0.0" ]] && vergt "${image_major}" "${max_upgrade}"; then
    echo "Can't start Nextcloud because the version of the data (${installed_version}) is more than one major version behind the docker image version (${image_version}) and upgrading more than one major version is not supported. Please run an image tagged for the major version ${max_upgrade} first."
    sleep infinity
fi

if [[ "${installed_version}" = "0.0.0.0" ]] || [[ -z "$(ls -A /config/www/nextcloud/apps 2>/dev/null)" ]]; then
    touch /tmp/needs_install
fi

if [[ "${installed_version}" != "0.0.0.0" ]] && vergt "${image_version}" "${installed_version}"; then
    touch /tmp/needs_upgrade
fi

# initialize nextcloud
if [[ -f /config/www/nextcloud/config/needs_migration ]] || [[ -f /tmp/needs_install ]] || [[ -f /tmp/needs_upgrade ]]; then
    echo "Initializing nextcloud ${image_version} (this can take a while) ..."
    if [[ -f /config/www/nextcloud/config/needs_migration ]] || [[ -f /tmp/needs_upgrade ]]; then
        echo "Upgrading nextcloud from ${installed_version} ..."
        shippedApps=$(jq -r .shippedApps[] /app/www/src/core/shipped.json)
        for app in ${shippedApps}; do
            rm -rf "/config/www/nextcloud/apps/${app}"
        done
    fi

    rsync -rlD --exclude-from=/app/upgrade.exclude /app/www/src/ /app/www/public/
    for dir in apps config themes; do
        if [[ -f /config/www/nextcloud/config/needs_migration ]] || [[ -f /tmp/needs_upgrade ]] || [[ -z "$(ls -A /app/www/public/${dir} 2>/dev/null)" ]]; then
            rsync -rlD --include "/${dir}" --exclude '/*' /app/www/src/ /config/www/nextcloud/
        fi
    done
    if [[ -z "$(ls -A "${NEXTCLOUD_DATADIR}/" 2>/dev/null)" ]]; then
        rsync -rlD --include "${NEXTCLOUD_DATADIR}" --exclude '/*' /app/www/src/ /
    fi

    echo "Setting permissions"
    lsiown abc:abc "${NEXTCLOUD_DATADIR}"
    lsiown -R abc:abc \
        /app/www/public \
        /config/www/nextcloud

    if [[ -f /config/www/nextcloud/config/needs_migration ]] || [[ -f /tmp/needs_upgrade ]]; then
        # Upgrade
        occ upgrade
    elif [[ -f /tmp/needs_install ]]; then
        # Install
        echo "New nextcloud instance"

        # Make sure all database settings are set
        if [[ "${DB_HOST+x}" && "${DB_USER+x}" && "${DB_NAME+x}" && "${#DB_PASS}" -gt "3" ]] && \
           [[ "${DB_TYPE}" == "sqlite" || "${DB_TYPE}" == "pgsql" || "${DB_TYPE}" == "mysql" ]]; then

            # Generate admin password, if missing
            if [[ ! "${ADMIN_PASS+x}" ]]; then
                ADMIN_PASS="$(openssl rand -hex 64)"
                echo "Nextcloud admin password: $ADMIN_PASS"
            fi

            # Run installation process
            echo "Running Nextcloud installation..."
            occ maintenance:install \
                --database="${DB_TYPE}" \
                --database-host="${DB_HOST}" \
                --database-name="${DB_NAME}" \
                --database-user="${DB_USER}" \
                --database-pass="${DB_PASS}" \
                --admin-user="${ADMIN_USER:-admin}" \
                --admin-pass="${ADMIN_PASS}" \
                --data-dir="${NEXTCLOUD_DATADIR}"

            # Check return code
            if [[ $? -eq 0 ]]; then
                echo "Nextcloud installation successful!"
            else
                echo "Nextcloud installation failed!"
                echo "Please run the web-based installer or check the logs."
            fi
        else
            echo "Please run the web-based installer on first connect!"
        fi
    fi

    echo "Initializing finished"
else
    #! Fix missing /app/www/public/occ
    rsync -rlD --exclude-from=/app/upgrade.exclude /app/www/src/ /app/www/public/
fi

rm -f \
    /config/www/nextcloud/config/needs_migration \
    /tmp/needs_install \
    /tmp/needs_upgrade

# permissions
lsiown abc:abc \
    /app/www/public \
    /config/www/nextcloud

CONFIG_FILE="/config/nextcloud.json"

if [ ! -f "$CONFIG_FILE" ]; then
  echo '{}' > "$CONFIG_FILE"
fi

current_data_dir=$(jq -r ".data_location // empty" "${CONFIG_FILE}")

if [ -z "$current_data_dir" ]; then
  jq --arg path "$NEXTCLOUD_DATADIR" '.data_location = $path' "$CONFIG_FILE" > "${CONFIG_FILE}.tmp" && mv "${CONFIG_FILE}.tmp" "$CONFIG_FILE"
  current_data_dir="$NEXTCLOUD_DATADIR"
fi

if [[ "$current_data_dir" != "$NEXTCLOUD_DATADIR" ]]; then
    if [[ ! -d "$current_data_dir" ]] || [[ ! -f "$current_data_dir/.ncdata" ]]; then
        bashio::log.warning "-----------------------------------------------------------------------------------------------------------------------"
        bashio::log.warning "Unable to find a data folder in ($current_data_dir)."
        bashio::log.warning "-----------------------------------------------------------------------------------------------------------------------"
        bashio::log.warning "This is expected if you manually moved the Nextcloud Data folder somewhere else"
        if [[ -d "$NEXTCLOUD_DATADIR" ]] && [[ -f "$NEXTCLOUD_DATADIR/.ncdata" ]]; then
            bashio::log.info "-----------------------------------------------------------------------------------------------------------------------"
            bashio::log.info "Nexcloud data directory found in (${NEXTCLOUD_DATADIR})"
            bashio::log.info "-----------------------------------------------------------------------------------------------------------------------"
            bashio::log.info "Setting this as new data directory without migration"
        else
            bashio::log.error "-----------------------------------------------------------------------------------------------------------------------"
            bashio::log.error "Unable to find a data folder in (${NEXTCLOUD_DATADIR})"
            bashio::log.error "-----------------------------------------------------------------------------------------------------------------------"
            bashio::log.error "Nextcloud cannot start without a valid data directory."
            bashio::log.error "Please make sure to set the correct path in the app configuration and restart it"
            bashio::addon.stop
            exit 1
        fi
    else
        occ maintenance:mode --on || true
        bashio::log.info "Migrating data directory from $current_data_dir to ${NEXTCLOUD_DATADIR}"
        /usr/local/bin/storage-folder-migration.sh "$current_data_dir" "${NEXTCLOUD_DATADIR}"
    fi
    sed -i "s|$current_data_dir|$NEXTCLOUD_DATADIR|" "/config/www/nextcloud/config/config.php"
    occ config:system:set datadirectory --value="${NEXTCLOUD_DATADIR}"
    jq --arg path "$NEXTCLOUD_DATADIR" '.data_location = $path' "$CONFIG_FILE" > "${CONFIG_FILE}.tmp" && mv "${CONFIG_FILE}.tmp" "$CONFIG_FILE"
    occ maintenance:mode --off
fi

# setup config
if occ config:system:get installed >/dev/null 2>&1; then
    if ! occ config:system:get redis >/dev/null 2>&1; then
        occ config:system:set redis host --value="$REDIS_SOCKET"
        occ config:system:set redis port --value=0 --type=integer
        occ config:system:set redis timeout --value=1.5
    fi
    if ! occ config:system:get memcache.local >/dev/null 2>&1; then
        occ config:system:set memcache.local --value='\\OC\\Memcache\\Redis'
    fi
    if ! occ config:system:get filelocking.enabled >/dev/null 2>&1; then
        occ config:system:set filelocking.enabled --value=true --type=boolean
    fi
    if ! occ config:system:get memcache.locking >/dev/null 2>&1; then
        occ config:system:set memcache.locking --value='\\OC\\Memcache\\Redis'
    fi
    if ! occ config:system:get datadirectory >/dev/null 2>&1; then
        occ config:system:set datadirectory --value="${NEXTCLOUD_DATADIR}"
    fi
    if ! occ config:system:get maintenance_window_start >/dev/null 2>&1; then
        occ config:system:set maintenance_window_start --value=4 --type=integer
    fi
    if ! occ config:system:get upgrade.disable-web >/dev/null 2>&1; then
        occ config:system:set upgrade.disable-web --value=true --type=boolean
    fi

    # Set admin password
    if [[ "${ADMIN_PASS+x}" ]]; then
        if ! occ user:resetpassword --password-from-env "${ADMIN_USER:-admin}" 2>&1; then
            bashio::log.error "-----------------------------------------------------------------------------------------------------------------------"
            bashio::log.error "Failed to set admin password for user ${ADMIN_USER:-admin}"
            bashio::log.error "Please make sure the password meets the Nextcloud requirements"
            bashio::log.error "-----------------------------------------------------------------------------------------------------------------------"
        else
            bashio::log.info "Admin password for user ${ADMIN_USER:-admin} set successfully"
        fi
    fi

    # Run maintenance steps, this also fixes warnings in the admin panel
    occ db:add-missing-indices
    occ maintenance:repair --include-expensive

fi

# remove problematic apps
for APP in richdocumentscode; do
    if (occ app:list | grep -q " - ${APP}:") 2>/dev/null; then
        echo "Removing ${APP}"
    fi
    APP_PATH=$(occ app:getpath "${APP}" 2>/dev/null)
    if [[ -z "${APP_PATH}" ]] || [[ ! -d "${APP_PATH}" ]]; then
        APP_PATH="/app/www/public/apps/${APP}"
    fi
    if [[ -d "${APP_PATH}" ]]; then
        occ app:disable "${APP}" >/dev/null 2>&1
    fi
    APP_STATUS="$(occ config:app:get "${APP}" enabled 2>/dev/null)"
    if [[ "${APP_STATUS}" != "no" ]] && [[ -n "${APP_STATUS}" ]]; then
        occ config:app:set "${APP}" enabled --value="no" >/dev/null 2>&1
    fi
    occ app:remove "${APP}" >/dev/null 2>&1
    rm -rf "${APP_PATH}"
done

# --------------------------------------------------------------------------------------------------------------------
# Addon specific configurations
# --------------------------------------------------------------------------------------------------------------------

OPTIONS_SOURCE=/data/options.json

# Trusted domains
#
# `trusted_domains` is optional and has no default. When it is left empty
# Nextcloud keeps only the `localhost` entry written by `occ maintenance:install`
# and answers every request that carries the Home Assistant host in the Host
# header with {"error":"Trusted domain error.","code":15}, which makes a fresh
# install unreachable from the LAN. So the user's list is taken as-is and the
# addresses this add-on can actually be reached on are appended to it.

TRUSTED_DOMAINS=()
mapfile -t TRUSTED_DOMAINS < <(jq -r '.trusted_domains // empty | .[]' "$OPTIONS_SOURCE")

# User-supplied entries come first and are never dropped or replaced.
FINAL_DOMAINS=()
for DOMAIN in "${TRUSTED_DOMAINS[@]}"; do
  DOMAIN="$(echo "$DOMAIN" | xargs)"
  if [ -n "$DOMAIN" ]; then
    FINAL_DOMAINS+=("$DOMAIN")
  fi
done

# Append an auto-detected entry, unless it is already in the list.
nc_add_trusted_domain() {
  local candidate="$1"
  local existing
  if [ -z "$candidate" ] || [ "$candidate" = "null" ]; then
    return 0
  fi
  for existing in "${FINAL_DOMAINS[@]}"; do
    if [ "$existing" = "$candidate" ]; then
      return 0
    fi
  done
  FINAL_DOMAINS+=("$candidate")
}

# Loopback, for occ/cron and everything talking to Nextcloud inside the add-on.
nc_add_trusted_domain "localhost"
nc_add_trusted_domain "127.0.0.1"

# This add-on's own container hostname, so other add-ons and reverse proxies
# (Cloudflare Tunnel, NGINX Proxy Manager, ...) can reach it over the internal
# Docker network.
nc_add_trusted_domain "${HOSTNAME:-$(hostname 2>/dev/null)}"

# The Home Assistant host itself: `webui: http://[HOST]:[PORT:80]` points at
# whatever address the user reaches Home Assistant on, so that address has to be
# trusted or the add-on is unusable straight after installation.
HOST_ADDRESS_FOUND=false

# The Supervisor's /info endpoint is readable by every add-on, no permission
# needed. It gives the host name, which covers http://<hostname>.local access.
HOST_HOSTNAME="$(bashio::info.hostname)"
if [ -n "$HOST_HOSTNAME" ] && [ "$HOST_HOSTNAME" != "null" ]; then
  nc_add_trusted_domain "$HOST_HOSTNAME"
  nc_add_trusted_domain "${HOST_HOSTNAME}.local"
fi

# /network/info and /network/interface/<name>/info are granted to the default
# add-on role, so `hassio_api: true` in config.yaml is all this needs.
HOST_INTERFACES=()
mapfile -t HOST_INTERFACES < <(bashio::network.interfaces)
if [ "${#HOST_INTERFACES[@]}" -eq 0 ]; then
  # Interface list unavailable: fall back to the primary interface only.
  HOST_INTERFACES=("default")
fi

for INTERFACE in "${HOST_INTERFACES[@]}"; do
  if [ -z "$INTERFACE" ]; then
    continue
  fi
  HOST_ADDRESSES=()
  mapfile -t HOST_ADDRESSES < <(bashio::network.ipv4_address "$INTERFACE")
  for ADDRESS in "${HOST_ADDRESSES[@]}"; do
    # The Supervisor reports CIDR notation, e.g. 192.168.1.50/24
    ADDRESS="${ADDRESS%%/*}"
    if [[ "$ADDRESS" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] && [ "$ADDRESS" != "127.0.0.1" ]; then
      nc_add_trusted_domain "$ADDRESS"
      HOST_ADDRESS_FOUND=true
    fi
  done
done

if [ "$HOST_ADDRESS_FOUND" != "true" ]; then
  bashio::log.warning "----------------------------------------------------------------------"
  bashio::log.warning "Could not determine the Home Assistant host's IP address, so it has"
  bashio::log.warning "NOT been added to Nextcloud's trusted domains automatically."
  bashio::log.warning "If the web interface answers with"
  bashio::log.warning "  {\"error\":\"Trusted domain error.\",\"code\":15}"
  bashio::log.warning "add the address you type in the browser (for example 192.168.1.50) to"
  bashio::log.warning "the 'trusted_domains' option of this add-on and restart it."
  bashio::log.warning "----------------------------------------------------------------------"
fi

# ---------------------------------------------------------------------------
# Cloudflare Tunnel (cloudflared) auto-detection
# ---------------------------------------------------------------------------
# When this add-on is exposed through a Cloudflare Tunnel, the public hostname
# is arbitrary and not known at install time. Detect a cloudflared add-on on
# the same Home Assistant OS and, when present, accept any hostname
# (URL-agnostic) and trust the local Docker network as a reverse proxy — so
# users never have to edit `trusted_domains` / `trusted_proxies` manually.
CLOUDFLARED_DETECTED=false
CLOUDFLARED_PROXY_SUBNET=""

if [[ -n "${SUPERVISOR_TOKEN:-}" ]] && command -v curl >/dev/null 2>&1; then
  SUPERVISOR_ADDONS="$(curl -sfS -m 10 \
    -H "Authorization: Bearer ${SUPERVISOR_TOKEN}" \
    "http://supervisor/addons" 2>/dev/null || true)"
  if [[ -n "${SUPERVISOR_ADDONS}" ]] && printf '%s' "${SUPERVISOR_ADDONS}" | grep -qiE 'cloudflared|cloudflare'; then
    CLOUDFLARED_DETECTED=true
  fi
fi

if [[ "${CLOUDFLARED_DETECTED}" = "true" ]]; then
  # Trust the /24 this container lives on (the HAOS hassio network, where the
  # cloudflared add-on also runs) so Nextcloud honours X-Forwarded-* headers.
  LOCAL_IP="$(ip -4 route get 1.1.1.1 2>/dev/null | grep -oE 'src [0-9.]+' | awk '{print $2}' | head -1)"
  if [[ -n "${LOCAL_IP}" ]]; then
    CLOUDFLARED_PROXY_SUBNET="$(printf '%s' "${LOCAL_IP}" | awk -F. '{printf "%d.%d.%d.0/24", $1, $2, $3}')"
  fi
  # Fallback to the well-known HAOS hassio subnet if derivation failed.
  [[ -n "${CLOUDFLARED_PROXY_SUBNET}" ]] || CLOUDFLARED_PROXY_SUBNET="172.30.32.0/23"

  # URL-agnostic catch-all: accept any public hostname the tunnel uses.
  nc_add_trusted_domain "*"

  bashio::log.info "Cloudflare Tunnel add-on detected — trusting proxy subnet ${CLOUDFLARED_PROXY_SUBNET} and any hostname (URL-agnostic)."
fi

# Rewrite the list, and only report what was really written.
occ config:system:delete trusted_domains > /dev/null 2>&1

INDEX=0
APPLIED_DOMAINS=()
for DOMAIN in "${FINAL_DOMAINS[@]}"; do
  if occ config:system:set trusted_domains "$INDEX" --value="$DOMAIN" > /dev/null; then
    APPLIED_DOMAINS+=("$DOMAIN")
    INDEX=$((INDEX + 1))
  else
    bashio::log.warning "Failed to set trusted_domains[$INDEX] = $DOMAIN"
  fi
done

if [ "${#APPLIED_DOMAINS[@]}" -eq 0 ]; then
  bashio::log.error "Could not write any trusted_domains entry; Nextcloud will keep rejecting requests with 'Trusted domain error.'"
else
  bashio::log.info "trusted_domains: ${APPLIED_DOMAINS[*]}"
fi

# Trusted proxies
mapfile -t TRUSTED_PROXIES < <(jq -r '.trusted_proxies // empty | .[]' "$OPTIONS_SOURCE")

# Append the auto-detected Cloudflare Tunnel proxy subnet, de-duplicated.
if [[ "${CLOUDFLARED_DETECTED}" = "true" ]] && [[ -n "${CLOUDFLARED_PROXY_SUBNET}" ]]; then
  PROXY_PRESENT=false
  for P in "${TRUSTED_PROXIES[@]}"; do
    if [[ "$P" = "${CLOUDFLARED_PROXY_SUBNET}" ]]; then
      PROXY_PRESENT=true
      break
    fi
  done
  if [[ "${PROXY_PRESENT}" != "true" ]]; then
    TRUSTED_PROXIES+=("${CLOUDFLARED_PROXY_SUBNET}")
  fi
fi

if [ "${#TRUSTED_PROXIES[@]}" -gt 0 ]; then
  occ config:system:del trusted_proxies
fi

INDEX=0
for PROXY in "${TRUSTED_PROXIES[@]}"; do
  PROXY="$(echo "$PROXY" | xargs)"
  echo "Setting trusted_proxies[$INDEX] = $PROXY"
  occ config:system:set trusted_proxies "$INDEX" --value="$PROXY"
  ((INDEX++))
done

echo "trusted_proxies updated successfully"

if [[ -n "$OVERWRITEPROTOCOL" ]]; then
    occ config:system:set overwriteprotocol --value="$OVERWRITEPROTOCOL"
else
    occ config:system:delete overwriteprotocol > /dev/null 2>&1
fi
if [[ -n "$OVERWRITEHOST" ]]; then
    occ config:system:set overwritehost --value="$OVERWRITEHOST"
else
    occ config:system:delete overwritehost > /dev/null 2>&1
fi
if [[ -n "$OVERWRITECLIURL" ]]; then
    occ config:system:set overwrite.cli.url --value="$OVERWRITECLIURL"
else
    occ config:system:set overwrite.cli.url --value="http://localhost"
fi
if [[ -n "$DEFAULT_PHONE_REGION" ]]; then
    occ config:system:set default_phone_region --value="$DEFAULT_PHONE_REGION"
else
    occ config:system:delete default_phone_region > /dev/null 2>&1
fi

# SMTP config
if ! occ config:system:get mail_smtpmode >/dev/null 2>&1; then
    occ config:system:set mail_smtpmode --value="smtp"
fi
if [[ -n "$SMTP_HOST" ]]; then
    occ config:system:set mail_smtphost --value="$SMTP_HOST" > /dev/null 2>&1
else
    occ config:system:delete mail_smtphost > /dev/null 2>&1
fi
if [[ -n "$SMTP_SECURE" ]]; then
    occ config:system:set mail_smtpsecure --value="$SMTP_SECURE"
else
    occ config:system:delete mail_smtpsecure > /dev/null 2>&1
fi
if [[ -n "$SMTP_PORT" ]]; then
    occ config:system:set mail_smtpport --value="$SMTP_PORT" --type=integer
else
    occ config:system:delete mail_smtpport > /dev/null 2>&1
fi
if [[ -n "$SMTP_AUTH" ]]; then
    occ config:system:set mail_smtpauth --value="$SMTP_AUTH" --type=boolean
else
    occ config:system:delete mail_smtpauth > /dev/null 2>&1
fi
if [[ -n "$SMTP_AUTHTYPE" ]]; then
    occ config:system:set mail_smtpauthtype --value="$SMTP_AUTHTYPE"
else
    occ config:system:delete mail_smtpauthtype > /dev/null 2>&1
fi
if [[ -n "$SMTP_USER" ]]; then
    occ config:system:set mail_smtpname --value="$SMTP_USER" > /dev/null 2>&1
else
    occ config:system:delete mail_smtpname > /dev/null 2>&1
fi
if [[ -n "$SMTP_PASS" ]]; then
    occ config:system:set mail_smtppassword --value="$SMTP_PASS" > /dev/null 2>&1
else
    occ config:system:delete mail_smtppassword > /dev/null 2>&1
fi
if [[ -n "$MAIL_FROM_ADDRESS" ]]; then
    occ config:system:set mail_from_address --value="$MAIL_FROM_ADDRESS" > /dev/null 2>&1
else
    occ config:system:delete mail_from_address > /dev/null 2>&1
fi
if [[ -n "$MAIL_DOMAIN" ]]; then
    occ config:system:set mail_domain --value="$MAIL_DOMAIN" > /dev/null 2>&1
else
    occ config:system:delete mail_domain > /dev/null 2>&1
fi