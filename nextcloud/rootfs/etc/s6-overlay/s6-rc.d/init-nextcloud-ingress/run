#!/command/with-contenv bash
# shellcheck shell=bash

set -euo pipefail

mkdir -p /config/nginx/site-confs

OPTIONS_FILE="/data/options.json"
PUBLIC_URL=""
if [[ -f "${OPTIONS_FILE}" ]]; then
    PUBLIC_URL=$(jq -r '.NEXTCLOUD_PUBLIC_URL // empty' "${OPTIONS_FILE}" 2>/dev/null || true)
    if [[ -z "${PUBLIC_URL}" ]]; then
        overwrite_host=$(jq -r '.OVERWRITEHOST // empty' "${OPTIONS_FILE}" 2>/dev/null || true)
        overwrite_proto=$(jq -r '.OVERWRITEPROTOCOL // "https"' "${OPTIONS_FILE}" 2>/dev/null || true)
        if [[ -n "${overwrite_host}" ]]; then
            PUBLIC_URL="${overwrite_proto}://${overwrite_host}"
        fi
    fi
    if [[ -z "${PUBLIC_URL}" ]]; then
        overwrite_cli=$(jq -r '.OVERWRITECLIURL // empty' "${OPTIONS_FILE}" 2>/dev/null || true)
        if [[ -n "${overwrite_cli}" ]]; then
            PUBLIC_URL="${overwrite_cli}"
        fi
    fi
fi

# Last-resort local URL keeps the wrapper useful on LAN-only installs.
if [[ -z "${PUBLIC_URL}" ]]; then
    PUBLIC_URL="http://homeassistant:8000"
fi

# Land on the Files app after login.
PUBLIC_URL="${PUBLIC_URL%/}"
case "${PUBLIC_URL}" in
    */apps/*|*/login|*/index.php*) ;;
    *) PUBLIC_URL="${PUBLIC_URL}/apps/files/" ;;
esac

cat > /config/nginx/site-confs/woow-nextcloud-ingress.conf <<NGINX
# WOOWTECH Home Assistant sidebar wrapper for Nextcloud.
#
# The Nextcloud app itself is served by the stable direct/public endpoint, while
# this HA ingress listener provides the same Home Assistant headbar/chrome as
# other sidebar apps (for example Woow n8n).
server {
    listen 8090 default_server;
    server_name _;

    allow 172.30.32.2;
    deny all;

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 'ok\n';
    }

    location / {
        default_type text/html;
        charset utf-8;
        add_header Cache-Control 'no-store' always;
        return 200 '<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Woow Nextcloud</title><style>html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#111}iframe{border:0;width:100vw;height:100vh;display:block;position:relative;z-index:2}.fallback{position:absolute;z-index:1;inset:0;display:grid;place-items:center;color:white;font-family:system-ui,sans-serif;background:#111}.fallback a{color:#4ea3ff}</style></head><body><div class="fallback"><p>Opening Woow Nextcloud… <a id="open" target="_blank">open in new tab</a></p></div><iframe id="nc" allow="clipboard-read; clipboard-write; fullscreen; camera; microphone; display-capture"></iframe><script>(function(){var u="${PUBLIC_URL}";document.getElementById("open").href=u;document.getElementById("nc").src=u;})();</script></body></html>';
    }
}
NGINX

chmod 0644 /config/nginx/site-confs/woow-nextcloud-ingress.conf
