#!/command/with-contenv bash
# shellcheck shell=bash

set -euo pipefail

mkdir -p /config/nginx/site-confs

OPTIONS_FILE="/data/options.json"
PUBLIC_URL=""
if [[ -f "${OPTIONS_FILE}" ]]; then
    PUBLIC_URL=$(jq -r '.NEXTCLOUD_PUBLIC_URL // empty' "${OPTIONS_FILE}" 2>/dev/null || true)
    if [[ -z "${PUBLIC_URL}" ]]; then
        overwrite_host=$(jq -r '.OVERWRITEHOST // empty' "${OPTIONS_FILE}" 2>/dev/null || true)
        overwrite_proto=$(jq -r '.OVERWRITEPROTOCOL // "https"' "${OPTIONS_FILE}" 2>/dev/null || true)
        if [[ -n "${overwrite_host}" ]]; then
            PUBLIC_URL="${overwrite_proto}://${overwrite_host}"
        fi
    fi
    if [[ -z "${PUBLIC_URL}" ]]; then
        overwrite_cli=$(jq -r '.OVERWRITECLIURL // empty' "${OPTIONS_FILE}" 2>/dev/null || true)
        if [[ -n "${overwrite_cli}" ]]; then
            PUBLIC_URL="${overwrite_cli}"
        fi
    fi
fi

# Last-resort local URL keeps the launcher useful on LAN-only installs.
if [[ -z "${PUBLIC_URL}" ]]; then
    PUBLIC_URL="http://homeassistant:8000"
fi

# Make sidebar opens land on the Files app after login.
PUBLIC_URL="${PUBLIC_URL%/}"
case "${PUBLIC_URL}" in
    */apps/*|*/login|*/index.php*) ;;
    *) PUBLIC_URL="${PUBLIC_URL}/apps/files/" ;;
esac

cat > /config/nginx/site-confs/woow-nextcloud-ingress.conf <<NGINX
# WOOWTECH Home Assistant sidebar launcher for Nextcloud.
#
# Nextcloud's full web UI intentionally runs on the stable direct/public URL.
# HA Supervisor Ingress uses /api/hassio_ingress/<token>, which causes
# Nextcloud session-cookie and post-login redirect loops. Therefore this
# listener is only a sidebar launcher; WebDAV, desktop/mobile sync, Office/WOPI,
# and the browser UI all use the direct/public endpoint.
server {
    listen 8090 default_server;
    server_name _;

    allow 172.30.32.2;
    deny all;

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 'ok\n';
    }

    location / {
        add_header Content-Type 'text/html; charset=utf-8' always;
        add_header Cache-Control 'no-store' always;
        return 200 '<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Opening Woow Nextcloud</title><script>const u="${PUBLIC_URL}";try{window.top.location.replace(u)}catch(e){window.location.replace(u)}</script><meta http-equiv="refresh" content="0;url=${PUBLIC_URL}"></head><body style="font-family:system-ui,sans-serif;padding:2rem"><h1>Opening Woow Nextcloud…</h1><p>If it does not open automatically, <a target="_top" href="${PUBLIC_URL}">open Woow Nextcloud</a>.</p></body></html>';
    }
}
NGINX

chmod 0644 /config/nginx/site-confs/woow-nextcloud-ingress.conf
