#!/command/with-contenv bash
# shellcheck shell=bash

set -euo pipefail

mkdir -p /config/nginx/site-confs

cat > /config/nginx/site-confs/woow-nextcloud-ingress.conf <<'NGINX'
# WOOWTECH Home Assistant Ingress adapter for Nextcloud.
# Direct access on port 80 is intentionally untouched; this listener is only
# used by Home Assistant Supervisor via /api/hassio_ingress/<token>.
server {
    listen 8090 default_server;
    server_name _;

    # Home Assistant Ingress requests are proxied by the Supervisor. Keep the
    # UI private to HA; direct LAN/Cloudflare access must use port 80 instead.
    allow 172.30.32.2;
    deny all;

    absolute_redirect off;
    client_max_body_size 0;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;

    # Watchdog endpoint for Supervisor. It must not hit Nextcloud because early
    # install/upgrade states can return redirects or maintenance pages.
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 'ok\n';
    }

    location / {
        set $safe_ingress_path "";
        if ($http_x_ingress_path ~ "^/api/hassio_ingress/[A-Za-z0-9_-]{16,128}$") {
            set $safe_ingress_path $http_x_ingress_path;
        }
        if ($safe_ingress_path = "") {
            return 400;
        }

        proxy_pass http://127.0.0.1:80;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix $safe_ingress_path;
        proxy_set_header Accept-Encoding "";
        proxy_set_header If-None-Match "";
        proxy_set_header If-Modified-Since "";

        proxy_cookie_path / $safe_ingress_path/;
        # Nextcloud may emit either origin-relative redirects or absolute URLs
        # based on overwritehost/overwriteprotocol. Keep both inside HA ingress.
        proxy_redirect ~^https?://[^/]+(/.*)$ $safe_ingress_path$1;
        proxy_redirect ~^(/.*)$ $safe_ingress_path$1;

        sub_filter_once off;
        sub_filter_types text/html text/css text/xml application/javascript text/javascript application/json application/xml;

        # Static markup and CSS URLs emitted by Nextcloud core/apps.
        sub_filter 'href="/' 'href="$safe_ingress_path/';
        sub_filter 'src="/' 'src="$safe_ingress_path/';
        sub_filter 'action="/' 'action="$safe_ingress_path/';
        sub_filter 'content="/' 'content="$safe_ingress_path/';
        sub_filter 'url(/' 'url($safe_ingress_path/';

        # Nextcloud JavaScript bootstrap. Keeping oc_webroot prefix-aware makes
        # generated fetch/XHR/navigation URLs behave the same as direct port 80.
        sub_filter 'var _oc_webroot="";' 'var _oc_webroot="$safe_ingress_path";';
        sub_filter "var _oc_webroot='';" "var _oc_webroot='$safe_ingress_path';";
        sub_filter '"_oc_webroot":""' '"_oc_webroot":"$safe_ingress_path"';
        sub_filter '"webroot":""' '"webroot":"$safe_ingress_path"';
        sub_filter 'OC.webroot=""' 'OC.webroot="$safe_ingress_path"';
        sub_filter "OC.webroot=''" "OC.webroot='$safe_ingress_path'";
    }
}
NGINX

chmod 0644 /config/nginx/site-confs/woow-nextcloud-ingress.conf
