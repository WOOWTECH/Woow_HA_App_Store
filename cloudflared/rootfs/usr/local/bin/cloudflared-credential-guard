#!/usr/bin/env python3
"""Protect only cloudflared credential files, without reading their contents."""
import os
from pathlib import Path
import stat
import sys

NAMES = ("cert.pem", "tunnel.json")


def protect(directory=Path("/data")):
    directory_fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        for name in NAMES:
            try:
                fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK,
                             dir_fd=directory_fd)
            except FileNotFoundError:
                continue
            try:
                before = os.fstat(fd)
                if not stat.S_ISREG(before.st_mode) or before.st_nlink != 1:
                    raise ValueError("unsafe credential file")
                # Runtime is root. Normalize imported/restored ownership before
                # chmod: some restore environments deny chmod after chown away.
                os.fchown(fd, os.geteuid(), os.getegid())
                os.fchmod(fd, 0o600)
                after = os.fstat(fd)
                current = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
                if ((current.st_dev, current.st_ino) != (after.st_dev, after.st_ino)
                        or after.st_nlink != 1
                        or stat.S_IMODE(after.st_mode) != 0o600
                        or (after.st_uid, after.st_gid) != (os.geteuid(), os.getegid())):
                    raise ValueError("credential protection failed")
            finally:
                os.close(fd)
    finally:
        os.close(directory_fd)


if __name__ == "__main__":
    try:
        protect()
    except (OSError, ValueError):
        # Never echo exception text, paths, file contents or credentials.
        print("Credential permission check failed", file=sys.stderr)
        sys.exit(1)
