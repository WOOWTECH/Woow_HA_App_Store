#!/command/with-contenv bashio
# shellcheck shell=bash

set -e

# Redis is offered to workflows (e.g. the Redis node) on localhost:6379 inside
# this container; n8n itself does not use it. It has no password, so it only
# listens on loopback and its socket is not world-writable. The command-line
# options below override an older /config/redis/redis.conf that still says
# "protected-mode no".
unset SUPERVISOR_TOKEN HASSIO_TOKEN

OPTIONS_SOURCE=${ADDON_DATA_FOLDER:-"/data"}/options.json

# make redis folders
mkdir -p \
	"${REDIS_DATADIR:-/config/redis}" \
	/data/logs/redis \
	/var/run/redis

# copy redis defaults
[[ ! -f "${REDIS_DATADIR:-/config/redis}/redis.conf" ]] &&
	cp /defaults/redis.conf ${REDIS_DATADIR:-/config/redis}/redis.conf

# permissions
chown -R redis:redis \
	"${REDIS_DATADIR:-/config/redis}" \
	/data/logs/redis \
	/var/run/redis

if jq -e '.clean_redis == true' "$OPTIONS_SOURCE" > /dev/null; then
	rm -f "${REDIS_DATADIR:-/config/redis}/dump.rdb"
fi

# exec: no shell stays behind holding the environment this script started with.
exec s6-notifyoncheck -s 1000 -n 300 -w 1000 -c "redis-cli PING" \
	s6-setuidgid redis \
		redis-server ${REDIS_DATADIR:-/config/redis}/redis.conf \
		--bind 127.0.0.1 -::1 \
		--protected-mode yes \
		--port 6379 \
		--pidfile /var/run/redis/redis.pid \
		--always-show-logo no \
		--dir "${REDIS_DATADIR:-/config/redis}" \
		--daemonize no \
		--logfile /data/logs/redis/redis.log \
		--unixsocket /var/run/redis/redis.sock \
		--unixsocketperm 770
