#!/command/with-contenv bash
# shellcheck shell=bash

set -e

echo "  Loading env variables:"

OPTIONS_SOURCE=/data/options.json

jq -r 'keys[]' "${OPTIONS_SOURCE}" | while read -r KEY; do
    # Skip env_vars array — handled separately below
    if [ "$KEY" = "env_vars" ]; then
        continue
    fi

    # export key
    value=$(jq -r --arg key "$KEY" '.[$key]' "${OPTIONS_SOURCE}")

    # Continue for single values
    line="${KEY}=${value}"

    # log redacted config
    case "$KEY" in
        *PASS*|*SECRET*|*KEY*)
            echo "    ${KEY}=******"
            ;;
        *)
            echo "    $line"
            ;;
    esac

    export line

    # set .env
    echo "$line" >> /.env || true

    # set /etc/environment
    echo "$line" >> /etc/environment

    # For s6
    if [ -d /var/run/s6/container_environment ]; then
        printf "%s" "$value" > /var/run/s6/container_environment/"${KEY}"
    fi
    echo "export $line" >> ~/.bashrc
done

# Handle env_vars array: [{key: "FOO", value: "bar"}, ...]
ENV_VARS_COUNT=$(jq -r '.env_vars | length' "${OPTIONS_SOURCE}" 2>/dev/null || echo 0)
if [ "$ENV_VARS_COUNT" -gt 0 ]; then
    echo "  Loading custom env_vars (${ENV_VARS_COUNT}):"
    for i in $(seq 0 $((ENV_VARS_COUNT - 1))); do
        KEY=$(jq -r ".env_vars[$i].key" "${OPTIONS_SOURCE}")
        value=$(jq -r ".env_vars[$i].value" "${OPTIONS_SOURCE}")
        line="${KEY}=${value}"

        case "$KEY" in
            *PASS*|*SECRET*|*KEY*)
                echo "    ${KEY}=******"
                ;;
            *)
                echo "    $line"
                ;;
        esac

        echo "$line" >> /.env || true
        echo "$line" >> /etc/environment

        if [ -d /var/run/s6/container_environment ]; then
            printf "%s" "$value" > /var/run/s6/container_environment/"${KEY}"
        fi
        echo "export $line" >> ~/.bashrc
    done
fi

if [ -n "$TZ" ] && [ -f /etc/localtime ]; then
    if [ -f /usr/share/zoneinfo/"$TZ" ]; then
        echo "Timezone set from $(cat /etc/timezone) to $TZ"
        ln -snf /usr/share/zoneinfo/"$TZ" /etc/localtime
        echo "$TZ" >/etc/timezone
    fi
fi
