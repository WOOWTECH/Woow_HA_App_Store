#!/command/with-contenv bashio
# shellcheck shell=bash

set -e

OPTIONS_SOURCE=/data/options.json
S6_ENV_DIR="${S6_ENV_DIR:-/var/run/s6/container_environment}"

set_s6_env() {
    mkdir -p "${S6_ENV_DIR}"
    printf "%s" "$2" > "${S6_ENV_DIR}/$1"
}

if ! ha_address="$(bashio::network.ipv4_address 2>/dev/null)"; then
    ha_address="homeassistant.local"
else
    ha_address=${ha_address%%/*}
fi

# WOOWTECH: Always use HTTP for LAN access
# For HTTPS, use Cloudflare Tunnel externally
protocol="http"

if ! port=$(bashio::addon.port 5678 2>/dev/null); then
    port=5678
fi

set_s6_env N8N_PROTOCOL "$protocol"

# This add-on's supported origin is plain HTTP (direct LAN port and HA
# Ingress). n8n refuses sign-in over http:// when N8N_SECURE_COOKIE=true, and
# existing Home Assistant installations may keep an older/user-provided true
# option across add-on updates. Force the effective runtime value to false so
# the whole UI remains browseable through HTTP.
set_s6_env N8N_SECURE_COOKIE "false"

if [ -z "${N8N_HOST:-}" ]; then
    set_s6_env N8N_HOST "$ha_address"
fi

# n8n 2.35+ reads N8N_WEBHOOK_URL; WEBHOOK_URL is a deprecated alias that
# makes n8n print a deprecation warning on every start. Only a WEBHOOK_URL the
# user configured is mirrored (so older configurations keep working); the
# add-on itself never sets the deprecated name.
if [ -n "${WEBHOOK_URL:-}" ] && [ -z "${N8N_WEBHOOK_URL:-}" ]; then
    set_s6_env N8N_WEBHOOK_URL "$WEBHOOK_URL"
elif [ -z "${WEBHOOK_URL:-}" ] && [ -z "${N8N_WEBHOOK_URL:-}" ]; then
    set_s6_env N8N_WEBHOOK_URL "${protocol}://${ha_address}:${port}"
fi

# Every proxied path reaches n8n through exactly one proxy that sets a clean
# X-Forwarded-For with the client address: the ingress nginx (which reduces
# the Supervisor ingress chain to the client address seen by Home Assistant)
# or cloudflared for the Cloudflare hostname. Trust that one hop unless the
# user chose a value; with the default (no trusted proxy) n8n's rate limiter
# logs ERR_ERL_UNEXPECTED_X_FORWARDED_FOR on every proxied request.
if [ -z "${N8N_PROXY_HOPS:-}" ]; then
    set_s6_env N8N_PROXY_HOPS 1
fi

# Task broker authentication. Every installation gets its own random secret,
# generated once and kept in the add-on's private /data (root-only, included
# in add-on backups). n8n reads it through N8N_RUNNERS_AUTH_TOKEN_FILE, so the
# value itself is not part of the n8n process environment that workflow
# expressions can read through $env; svc-runner hands it to the launcher.
# A token the user set explicitly through env_vars is kept as is.
RUNNER_TOKEN_FILE="${WOOW_RUNNER_TOKEN_FILE:-/data/n8n-runners-auth-token}"
if [ -z "${N8N_RUNNERS_AUTH_TOKEN:-}" ]; then
    if [ ! -s "${RUNNER_TOKEN_FILE}" ]; then
        (
            umask 077
            token="$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')"
            [ "${#token}" -eq 64 ]
            printf '%s' "${token}" > "${RUNNER_TOKEN_FILE}.tmp"
            mv -f "${RUNNER_TOKEN_FILE}.tmp" "${RUNNER_TOKEN_FILE}"
        )
        echo "Generated a new task broker token for this installation"
    fi
    chmod 600 "${RUNNER_TOKEN_FILE}"
    set_s6_env N8N_RUNNERS_AUTH_TOKEN_FILE "${RUNNER_TOKEN_FILE}"
fi

# This script is the add-on's last user of the Supervisor API. Drop the token
# from the s6 container environment so no service started afterwards - and no
# workflow Code node, which runs as root and could read these files - can
# obtain it. Every add-on start recreates the container and this directory.
rm -f "${S6_ENV_DIR}/SUPERVISOR_TOKEN" "${S6_ENV_DIR}/HASSIO_TOKEN"
