{
  "name": "paseo",
  "displayName": "Agent Connect",
  "description": "Connect code-server agents to Paseo, Woowtech Smart and Apporo Smart. Configure, pair and verify real conversations.",
  "version": "0.2.0",
  "publisher": "woowtech",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "code-server",
    "agents",
    "paseo",
    "Claude",
    "Codex",
    "Pi",
    "agent-connect",
    "woowtech-smart",
    "apporo-smart"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./out/extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Connector controls execute the installed runtime and expose this workspace to authorized remote agent sessions."
    },
    "virtualWorkspaces": false
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/WOOWTECH/Woow_podman_code_server_package.git",
    "directory": "extensions/paseo"
  },
  "homepage": "https://github.com/WOOWTECH/Woow_podman_code_server_package",
  "bugs": {
    "url": "https://github.com/WOOWTECH/Woow_podman_code_server_package/issues"
  },
  "galleryBanner": {
    "color": "#172b30",
    "theme": "dark"
  },
  "contributes": {
    "commands": [
      {
        "command": "woow.paseo.open",
        "title": "Open Connection Panel",
        "category": "Agent Connect"
      },
      {
        "command": "woow.paseo.configure",
        "title": "Configure Workspace",
        "category": "Agent Connect"
      },
      {
        "command": "woow.paseo.status",
        "title": "Refresh Connection Status",
        "category": "Agent Connect"
      },
      {
        "command": "woow.paseo.start",
        "title": "Start Connection",
        "category": "Agent Connect"
      },
      {
        "command": "woow.paseo.stop",
        "title": "Stop Connection",
        "category": "Agent Connect"
      },
      {
        "command": "woow.paseo.restore",
        "title": "Restore Confirmed Connection",
        "category": "Agent Connect"
      },
      {
        "command": "woow.paseo.models",
        "title": "Show Available Models",
        "category": "Agent Connect"
      },
      {
        "command": "woow.paseo.verify",
        "title": "Verify Real Conversation",
        "category": "Agent Connect"
      },
      {
        "command": "woow.paseo.openWeb",
        "title": "Open Selected Web App",
        "category": "Agent Connect"
      },
      {
        "command": "woow.paseo.settings",
        "title": "Open Extension Settings",
        "category": "Agent Connect"
      },
      {
        "command": "woow.paseo.pair",
        "title": "Pair with Selected Web App",
        "category": "Agent Connect"
      },
      {
        "command": "woow.paseo.refreshMcp",
        "title": "Refresh shared MCP",
        "category": "Agent Connect"
      },
      {
        "command": "woow.paseo.selectWeb",
        "title": "Choose Web App",
        "category": "Agent Connect"
      }
    ],
    "configuration": {
      "title": "Agent Connect",
      "properties": {
        "woow.paseo.runtimePath": {
          "type": "string",
          "default": "/usr/local/bin/woow-connectors",
          "description": "Absolute path to the installed WOOW connector runtime. This executable runs in the code-server container.",
          "scope": "machine"
        },
        "woow.paseo.workspace": {
          "type": "string",
          "default": "/workspace",
          "description": "Absolute container workspace to expose to remote agent sessions. Apply with Configure Workspace after editing.",
          "scope": "machine"
        },
        "woow.paseo.hostName": {
          "type": "string",
          "default": "code-server",
          "description": "Display name for this deployment. Apply with Configure Workspace after editing.",
          "scope": "machine"
        },
        "woow.paseo.webUrl": {
          "type": "string",
          "default": "https://app.paseo.sh",
          "description": "Web app URL used by Open Web. Existing saved URLs are retained. Private pairing requires a supported connection profile selected with Configure Workspace or Choose Web App; do not paste a pairing URL here.",
          "scope": "machine"
        },
        "woow.paseo.target": {
          "type": "string",
          "enum": [
            "paseo",
            "woowtech",
            "apporo"
          ],
          "enumDescriptions": [
            "Paseo official app and relay",
            "Woowtech Smart app and relay",
            "Apporo Smart app and relay"
          ],
          "default": "paseo",
          "description": "Connection profile: app, relay and host identity. Apply with Configure Workspace or Choose Web App. Restart an idle connection if the panel reports pending settings. Existing saved Web URLs are retained.",
          "scope": "machine"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "woow-paseo",
          "title": "Agent Connect",
          "icon": "media/connector.svg"
        }
      ]
    },
    "views": {
      "woow-paseo": [
        {
          "id": "woow.paseo.statusView",
          "name": "Agent Connect"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "woow.paseo.open",
          "when": "view == woow.paseo.statusView",
          "group": "navigation@1"
        },
        {
          "command": "woow.paseo.status",
          "when": "view == woow.paseo.statusView",
          "group": "navigation@2"
        }
      ]
    }
  }
}
