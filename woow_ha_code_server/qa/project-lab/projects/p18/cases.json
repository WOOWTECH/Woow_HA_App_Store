[
  {
    "name": "urgent order consumes stock before earlier standard order",
    "input": {
      "stock": [
        {
          "sku": "A",
          "quantity": 5
        },
        {
          "sku": "B",
          "quantity": 2
        }
      ],
      "orders": [
        {
          "id": "Low",
          "priority": 2,
          "allowPartial": false,
          "lines": [
            {
              "sku": "A",
              "quantity": 4
            }
          ]
        },
        {
          "id": "High",
          "priority": 1,
          "allowPartial": false,
          "lines": [
            {
              "sku": "A",
              "quantity": 3
            },
            {
              "sku": "B",
              "quantity": 2
            }
          ]
        }
      ]
    },
    "expected": {
      "orders": [
        {
          "id": "High",
          "priority": 1,
          "status": "fulfilled",
          "allocated": [
            {
              "sku": "A",
              "quantity": 3
            },
            {
              "sku": "B",
              "quantity": 2
            }
          ],
          "backordered": []
        },
        {
          "id": "Low",
          "priority": 2,
          "status": "backordered",
          "allocated": [],
          "backordered": [
            {
              "sku": "A",
              "quantity": 4
            }
          ]
        }
      ],
      "remainingStock": [
        {
          "sku": "A",
          "quantity": 2
        },
        {
          "sku": "B",
          "quantity": 0
        }
      ],
      "totals": {
        "requestedUnits": 9,
        "allocatedUnits": 5,
        "backorderedUnits": 4,
        "fulfilledOrders": 1
      }
    }
  },
  {
