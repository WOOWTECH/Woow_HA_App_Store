        {
          "id": "Dinner",
          "paidBy": "Ada",
          "amountCents": 3000
        },
        {
          "id": "Taxi",
          "paidBy": "Ben",
          "amountCents": 1500,
          "split": [
            {
              "member": "Ada",
              "weight": 1
            },
            {
              "member": "Ben",
              "weight": 1
            }
          ]
        }
      ]
