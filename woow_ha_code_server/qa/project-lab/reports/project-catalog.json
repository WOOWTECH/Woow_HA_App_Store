[
  {
    "id": "p01",
    "title": "CSV Profile and Anomaly Report",
    "category": "Data quality",
    "version": "1.1.0",
    "description": "Parse quoted CSV, profile columns, detect blanks, mixed numeric values, duplicate rows and numeric outliers.",
    "example": {
      "csv": "name,amount\nAva,10\nBo,20\nAva,10\nCy,",
      "zScoreThreshold": 3,
      "delimiter": ","
    },
    "fields": [
      {
        "key": "csv",
        "label": "CSV including headers",
        "type": "textarea"
      },
      {
        "key": "delimiter",
        "label": "Delimiter (default comma)",
        "type": "text"
      },
      {
        "key": "zScoreThreshold",
        "label": "Outlier z-score threshold",
        "type": "number"
      }
    ]
  },
  {
    "id": "p02",
    "title": "JSON Structural Diff",
    "category": "Data comparison",
    "version": "1.1.0",
    "description": "Compare nested JSON using escaped JSON Pointer paths and deterministic add, remove and replace operations.",
    "example": {
      "before": {
        "count": 1,
        "tags": [
          "old"
        ]
      },
      "after": {
        "count": 2,
        "tags": [
          "new"
        ],
        "active": true
      }
    },
    "fields": [
      {
        "key": "before",
        "label": "Before JSON",
        "type": "json"
      },
      {
        "key": "after",
        "label": "After JSON",
        "type": "json"
      }
    ]
  },
  {
    "id": "p03",
    "title": "Record Deduplication",
    "category": "Data cleaning",
    "version": "1.1.0",
    "description": "Group records by normalized composite keys; retain first or last records, or fill missing values from duplicates.",
    "example": {
      "records": [
        {
          "email": " Ava@example.test ",
          "name": "Ava"
        },
        {
          "email": "ava@example.test",
          "phone": "1234"
        },
        {
          "email": "bo@example.test",
          "name": "Bo"
        }
      ],
      "keys": [
        "email"
      ],
      "mode": "merge"
    },
    "fields": [
      {
        "key": "records",
        "label": "Records",
        "type": "json"
      },
      {
        "key": "keys",
        "label": "Key fields",
        "type": "json"
      },
      {
        "key": "mode",
        "label": "Retention mode",
        "type": "select",
        "options": [
          "first",
          "last",
          "merge"
        ]
      }
    ]
  },
  {
    "id": "p04",
    "title": "Pivot Table Aggregation",
    "category": "Data analysis",
    "version": "1.1.0",
    "description": "Group records by one or more dimensions and calculate counts, sums, means, minima or maxima with grand totals.",
    "example": {
      "records": [
        {
          "region": "East",
          "sales": 10
        },
        {
          "region": "West",
          "sales": 8
        },
        {
          "region": "East",
          "sales": 20
        }
      ],
      "groupBy": [
        "region"
      ],
      "valueField": "sales",
      "operation": "sum"
    },
    "fields": [
      {
        "key": "records",
        "label": "Records",
        "type": "json"
      },
      {
        "key": "groupBy",
        "label": "Grouping fields",
        "type": "json"
      },
      {
        "key": "valueField",
        "label": "Numeric field",
        "type": "text"
      },
      {
        "key": "operation",
        "label": "Aggregation",
        "type": "select",
        "options": [
          "sum",
          "mean",
          "min",
          "max",
          "count"
        ]
      }
    ]
  },
  {
    "id": "p05",
    "title": "Deterministic Data Masking",
    "category": "Data privacy demos",
    "version": "1.1.0",
    "description": "Apply repeatable SHA-256 tokens, partial redaction, or email display masks to selected synthetic record fields.",
    "example": {
      "records": [
        {
          "name": "Ava",
          "email": "ava@example.test",
          "phone": "5551234"
        },
        {
          "name": "Ava",
          "email": "ava@example.test",
          "phone": "5559876"
        }
      ],
      "rules": [
        {
          "field": "name",
          "mode": "token"
        },
        {
          "field": "email",
          "mode": "email"
        },
        {
          "field": "phone",
          "mode": "redact",
          "keepLast": 2
        }
      ]
    },
    "fields": [
      {
        "key": "records",
        "label": "Synthetic records",
        "type": "json"
      },
      {
        "key": "rules",
        "label": "Masking rules",
        "type": "json"
      },
      {
        "key": "salt",
        "label": "Optional deterministic salt",
        "type": "text"
      }
    ]
  },
  {
    "id": "p06",
    "title": "Log Severity and Timeline Analyzer",
    "category": "Observability",
    "version": "1.1.0",
    "description": "Parse UTC log lines, normalize severity aliases, build time buckets, rank messages and report malformed lines.",
    "example": {
      "log": "2026-01-01T10:00:00Z INFO Started\n2026-01-01T10:05:00Z ERROR Timeout\n2026-01-01T11:00:00Z WARN Retrying",
      "bucketMinutes": 60
    },
    "fields": [
      {
        "key": "log",
        "label": "UTC timestamp LEVEL message, one per line",
        "type": "textarea"
      },
      {
        "key": "bucketMinutes",
        "label": "Bucket size in minutes",
        "type": "number"
      }
    ]
  },
  {
    "id": "p07",
    "title": "Time-Series Moving Averages and Anomalies",
    "category": "Time series",
    "version": "1.1.0",
    "description": "Compute trailing averages and detect deviations against the preceding full window, including constant-baseline changes.",
    "example": {
      "points": [
        {
          "time": "2026-01-01T00:00:00Z",
          "value": 10
        },
        {
          "time": "2026-01-01T01:00:00Z",
          "value": 10
        },
        {
          "time": "2026-01-01T02:00:00Z",
          "value": 10
        },
        {
          "time": "2026-01-01T03:00:00Z",
          "value": 30
        }
      ],
      "window": 3,
      "threshold": 3
    },
    "fields": [
      {
        "key": "points",
        "label": "Chronological UTC points",
        "type": "json"
      },
      {
        "key": "window",
        "label": "Window size",
        "type": "number"
      },
      {
        "key": "threshold",
        "label": "Anomaly z-score threshold",
        "type": "number"
      }
    ]
  },
  {
    "id": "p08",
    "title": "Record Schema Validator",
    "category": "Data quality",
    "version": "1.1.0",
    "description": "Validate required fields, primitive types, ranges, lengths, enums and email/date formats with per-record diagnostics.",
    "example": {
      "schema": {
        "name": {
          "type": "string",
          "required": true,
          "minLength": 1
        },
        "age": {
          "type": "integer",
          "min": 0,
          "max": 120
        }
      },
      "records": [
        {
          "name": "Ava",
          "age": 30
        },
        {
          "name": "",
          "age": -2
        }
      ],
      "allowUnknown": false
    },
    "fields": [
      {
        "key": "schema",
        "label": "Field rules",
        "type": "json"
      },
      {
        "key": "records",
        "label": "Records",
        "type": "json"
      }
    ]
  },
  {
    "id": "p09",
    "title": "Text Keyword Frequencies",
    "category": "Text analysis",
    "version": "1.1.0",
    "description": "Count Unicode words or contiguous phrases with stop words, minimum lengths, deterministic rankings and percentages.",
    "example": {
      "text": "Blue sky, blue sea. Sky!",
      "stopWords": [],
      "ngramSize": 1,
      "top": 10
    },
    "fields": [
      {
        "key": "text",
        "label": "Text to analyze",
        "type": "textarea"
      },
      {
        "key": "stopWords",
        "label": "Stop words",
        "type": "json"
      },
      {
        "key": "ngramSize",
        "label": "Words per phrase (1–3)",
        "type": "number"
      },
      {
        "key": "top",
        "label": "Maximum results",
        "type": "number"
      }
    ]
  },
  {
    "id": "p10",
    "title": "Data Reconciliation by Key",
    "category": "Data comparison",
    "version": "1.1.0",
    "description": "Reconcile two record sets by unique composite keys, with explicit missing values and optional numeric tolerance.",
    "example": {
      "left": [
        {
          "id": "A",
          "quantity": 5
        },
        {
          "id": "B",
          "quantity": 2
        }
      ],
      "right": [
        {
          "id": "A",
          "quantity": 6
        },
        {
          "id": "C",
          "quantity": 9
        }
      ],
      "keys": [
        "id"
      ],
      "numericTolerance": 0
    },
    "fields": [
      {
        "key": "left",
        "label": "Left records",
        "type": "json"
      },
      {
        "key": "right",
        "label": "Right records",
        "type": "json"
      },
      {
        "key": "keys",
        "label": "Key fields",
        "type": "json"
      },
      {
        "key": "numericTolerance",
        "label": "Absolute numeric tolerance",
        "type": "number"
      }
    ]
  },
  {
    "id": "p11",
    "title": "Inventory Reorder Planner",
    "category": "Inventory",
    "version": "1.1.0",
    "description": "Calculate reorder triggers, review-period targets, and pack-rounded purchase quantities.",
    "fields": [
      {
        "key": "reviewDays",
        "label": "Review interval (days)",
        "type": "number"
      },
      {
        "key": "items",
        "label": "Inventory items",
        "type": "json"
      }
    ],
    "example": {
      "reviewDays": 7,
      "items": [
        {
          "sku": "FILTER",
          "onHand": 10,
          "incoming": 5,
          "dailyUsage": 5,
          "leadDays": 3,
          "safetyStock": 5,
          "packSize": 12,
          "minimumOrder": 24
        },
        {
          "sku": "GLOVE",
          "onHand": 80,
          "dailyUsage": 4,
          "leadDays": 5
        }
      ]
    }
  },
  {
    "id": "p12",
    "title": "Kanban Transition Validator",
    "category": "Workflow",
    "version": "1.1.0",
    "description": "Apply atomic task transitions while enforcing workflow edges and completed prerequisites.",
    "fields": [
      {
        "key": "tasks",
        "label": "Tasks",
        "type": "json"
      },
      {
        "key": "transitions",
        "label": "Requested transitions",
        "type": "json"
      }
    ],
    "example": {
      "tasks": [
        {
          "id": "DESIGN",
          "status": "done"
        },
        {
          "id": "BUILD",
          "status": "ready",
          "dependencies": [
            "DESIGN"
          ]
        }
      ],
      "transitions": [
        {
          "id": "BUILD",
          "to": "in_progress"
        },
        {
          "id": "BUILD",
          "to": "review"
        },
        {
          "id": "BUILD",
          "to": "done"
        }
      ]
    }
  },
  {
    "id": "p13",
    "title": "Meeting Slot Overlap Finder",
    "category": "Scheduling",
    "version": "1.1.0",
    "description": "Intersect everyone’s availability and find duration-fitting meeting starts on a shared time grid.",
