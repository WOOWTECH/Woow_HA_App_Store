    "example": {
      "turnaroundMinutes": 15,
      "reservations": [
        {
          "id": "R1",
          "resource": "Room A",
          "start": "2026-11-10T09:00Z",
          "end": "2026-11-10T10:00Z"
        },
        {
          "id": "R2",
          "resource": "Room A",
          "start": "2026-11-10T10:00Z",
          "end": "2026-11-10T11:00Z"
        }
      ]
    }
  },
  {
