      {
        "key": "durationMinutes",
        "label": "Meeting duration (minutes)",
        "type": "number"
      },
      {
        "key": "stepMinutes",
        "label": "Start grid (minutes)",
        "type": "number"
      },
      {
        "key": "participants",
        "label": "Participant availability",
        "type": "json"
      }
    ],
    "example": {
      "durationMinutes": 30,
      "stepMinutes": 30,
      "participants": [
        {
          "name": "Ada",
          "availability": [
            {
              "start": "09:00",
              "end": "12:00"
            }
          ]
        },
        {
          "name": "Ben",
          "availability": [
            {
              "start": "10:00",
              "end": "11:00"
            }
          ]
        }
      ]
    }
  },
  {
    "id": "p14",
    "title": "Expense Splitting Ledger",
    "category": "Finance",
    "version": "1.1.0",
