#!/command/with-contenv bashio
# nginx-direct — optional non-ingress front for the ACP chat webview
# fallback (F2 in DOCS.md). Always part of the "user" bundle (s6 bundle
# membership is fixed at boot), but self-gates on direct_password here:
# if unset, this longrun idles forever instead of starting nginx, which
# is the correct "off by default" behaviour without needing to touch s6
# bundle membership at runtime (contents.d markers only take effect on
# the NEXT boot's s6-rc-compile, not the one already in progress).
set -e
exec 2>&1

DIRECT_PASSWORD="$(bashio::config 'direct_password' '')"

if [ -z "${DIRECT_PASSWORD}" ]; then
    bashio::log.debug "nginx-direct: direct_password not set — idling (this is the default; see DOCS.md)"
    exec sleep infinity
fi

bashio::log.warning "nginx-direct: direct_password is set — starting the direct front on 1338 with HTTP Basic auth. Map port 1338 explicitly if you want it reachable, and never do so without direct_password set."

mkdir -p /etc/nginx-direct
printf 'woowtech:%s\n' "$(openssl passwd -apr1 "${DIRECT_PASSWORD}")" > /etc/nginx-direct/.htpasswd

cat > /etc/nginx-direct/nginx.conf <<'NGINXEOF'
worker_processes 1;
pid /run/nginx-direct.pid;
events { worker_connections 1024; }
http {
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }
    server {
        listen 1338;
        auth_basic "Woow Code Server";
        auth_basic_user_file /etc/nginx-direct/.htpasswd;
        client_max_body_size 100M;
        proxy_read_timeout 3600s;
        proxy_buffering off;
        location / {
            proxy_pass http://127.0.0.1:1337;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
        }
    }
}
NGINXEOF

exec nginx -c /etc/nginx-direct/nginx.conf -g "daemon off;"
