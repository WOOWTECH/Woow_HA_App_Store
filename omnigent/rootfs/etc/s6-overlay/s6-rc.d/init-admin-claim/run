#!/command/with-contenv sh
# init-admin-claim — verify that server startup pre-seeded the admin. The name is
# retained for the existing s6 dependency graph. This service never calls /auth/setup.
set -eu

[ -r /var/run/omnigent.env ] && . /var/run/omnigent.env

log() { echo "[init-admin-claim] $*" >&2; }

log "waiting for omnigent-server /health"
for i in $(seq 1 60); do
    if curl -sSf --max-time 3 http://127.0.0.1:8000/health >/dev/null 2>&1; then
        log "server up after ~${i}s"
        break
    fi
    sleep 2
    if [ "$i" -eq 60 ]; then
        log "FATAL: server never answered /health"
        exit 1
    fi
done

INFO=$(curl -sS --max-time 5 http://127.0.0.1:8000/v1/info || echo '{}')
NEEDS=$(printf '%s' "${INFO}" | jq -r 'if .needs_setup == false then "false" else "true" end')

if [ "${NEEDS}" = "false" ]; then
    log "admin exists (needs_setup=false)"
    exit 0
fi

log "FATAL: server still needs setup. Check admin_password and server bootstrap logs; refusing to expose an unclaimed instance."
exit 1
