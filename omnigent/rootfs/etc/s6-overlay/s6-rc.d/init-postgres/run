#!/command/with-contenv sh
# init-postgres — one-shot: initdb the cluster on first boot, then ensure
# the `omnigent` role + database exist. Runs BEFORE svc-postgres so the
# data dir is guaranteed present when postmaster starts.
set -eu

# Env comes from init-addon-config via /run/s6/container_environment/.
# Explicit source of the env file too as belt-and-braces (POSIX shells
# won't otherwise see the values written this same boot).
[ -r /var/run/omnigent.env ] && . /var/run/omnigent.env

log() { echo "[init-postgres] $*" >&2; }

PGDATA=/data/postgres
PGUSER_SYSTEM=postgres
# Alpine 3.24 ships postgres binaries in /usr/bin. Leave the libexec probe
# for portability to other base images.
PGBIN=$(ls -d /usr/libexec/postgresql* 2>/dev/null | head -1)
[ -n "${PGBIN}" ] || PGBIN=/usr/bin

mkdir -p "${PGDATA}"
chown -R ${PGUSER_SYSTEM}:${PGUSER_SYSTEM} "${PGDATA}"
chmod 700 "${PGDATA}"

# Alpine's postgres defaults to /run/postgresql for its unix socket dir.
# The dir doesn't exist inside a fresh addon container, so postmaster
# fails to bind. Also postgres user needs a home for .psql_history etc.
mkdir -p /run/postgresql /var/lib/postgresql
chown ${PGUSER_SYSTEM}:${PGUSER_SYSTEM} /run/postgresql /var/lib/postgresql
chmod 775 /run/postgresql

if [ ! -f "${PGDATA}/PG_VERSION" ]; then
    log "initdb — first boot, creating cluster at ${PGDATA}"
    su -s /bin/sh -c "${PGBIN}/initdb -D ${PGDATA} --encoding=UTF8 --locale=C" ${PGUSER_SYSTEM}

    # loopback-only; the addon container is the single tenant
    cat > "${PGDATA}/postgresql.conf" <<EOF
listen_addresses = '127.0.0.1'
port = 5432
max_connections = 100
shared_buffers = 128MB
dynamic_shared_memory_type = posix
logging_collector = off
log_min_messages = warning
timezone = 'UTC'
EOF
    cat > "${PGDATA}/pg_hba.conf" <<EOF
# TYPE  DATABASE  USER      ADDRESS        METHOD
local   all       all                      trust
host    all       all       127.0.0.1/32   md5
EOF
    chown ${PGUSER_SYSTEM}:${PGUSER_SYSTEM} "${PGDATA}/postgresql.conf" "${PGDATA}/pg_hba.conf"
fi

# --- Ensure role + db present ------------------------------------------------
# The postmaster isn't running yet during oneshot init, so start it in the
# background just long enough to run the bootstrap SQL, then stop.
if ! pgrep -x postgres >/dev/null 2>&1; then
    log "temporarily starting postgres to bootstrap role+db"
    su -s /bin/sh -c "${PGBIN}/pg_ctl -D ${PGDATA} -l /tmp/pg-bootstrap.log start" ${PGUSER_SYSTEM} || {
        log "pg_ctl start failed — dumping /tmp/pg-bootstrap.log:"
        cat /tmp/pg-bootstrap.log >&2 || true
        exit 1
    }
    for _ in $(seq 1 30); do
        su -s /bin/sh -c "${PGBIN}/pg_isready -q -h 127.0.0.1 -p 5432" ${PGUSER_SYSTEM} && break
        sleep 1
    done
    if ! su -s /bin/sh -c "${PGBIN}/pg_isready -q -h 127.0.0.1 -p 5432" ${PGUSER_SYSTEM}; then
        log "postgres never became ready — dumping /tmp/pg-bootstrap.log:"
        cat /tmp/pg-bootstrap.log >&2 || true
        exit 1
    fi

    if ! su -s /bin/sh -c "psql -tAc \"SELECT 1 FROM pg_roles WHERE rolname='omnigent'\" postgres" ${PGUSER_SYSTEM} | grep -q 1; then
        su -s /bin/sh -c "psql -c \"CREATE ROLE omnigent LOGIN PASSWORD '${POSTGRES_PASSWORD}';\" postgres" ${PGUSER_SYSTEM}
    fi
    if ! su -s /bin/sh -c "psql -tAc \"SELECT 1 FROM pg_database WHERE datname='omnigent'\" postgres" ${PGUSER_SYSTEM} | grep -q 1; then
        su -s /bin/sh -c "createdb -O omnigent omnigent" ${PGUSER_SYSTEM}
    fi

    su -s /bin/sh -c "${PGBIN}/pg_ctl -D ${PGDATA} stop -m fast" ${PGUSER_SYSTEM}
fi

log "postgres data dir + role omnigent + database omnigent ready"
