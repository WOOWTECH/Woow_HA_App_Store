#!/command/with-contenv sh
# init-omnigent-config — wait for postgres to accept queries before letting
# svc-omnigent-server start. Bare `pg_isready` from the loopback socket.
set -eu
[ -r /var/run/omnigent.env ] && . /var/run/omnigent.env

log() { echo "[init-omnigent-config] $*" >&2; }

for i in $(seq 1 30); do
    if pg_isready -q -h 127.0.0.1 -p 5432 -U omnigent; then
        log "postgres ready after ~${i}s"
        # Old installs may have an empty admin_password option. In that case the
        # server would expose /auth/setup if the DB lost its admin. Check BEFORE
        # the server starts; a missing users table or failed query also fails closed.
        if [ -z "${OMNIGENT_ADMIN_PASSWORD:-}" ]; then
            count=$(printf "SELECT count(*) FROM users WHERE id = :'admin_name' AND is_admin AND password_hash IS NOT NULL;\n" \
                | PGPASSWORD="${POSTGRES_PASSWORD:-}" psql -X -qAt -v ON_ERROR_STOP=1 \
                    -v "admin_name=${OMNIGENT_ADMIN_USERNAME:-}" -h 127.0.0.1 -U omnigent -d omnigent) \
                || { log 'FATAL: cannot verify the existing admin account; set admin_password before starting'; exit 1; }
            [ "$count" = 1 ] || { log 'FATAL: no existing admin account; set admin_password before starting'; exit 1; }
        fi
        exit 0
    fi
    sleep 1
done
log "ERROR: postgres never came up — svc-omnigent-server will fail to bind"
exit 1
