  "sdk": "1.30.0",
  "tools": {
   "tools": [
    {
     "description": "Check Open Design daemon health status and version.",
     "inputSchema": {
      "properties": {},
      "title": "healthArguments",
      "type": "object"
     },
     "name": "health"
    },
    {
     "description": "Get detailed daemon version info (version, channel, platform, arch).",
     "inputSchema": {
      "properties": {},
      "title": "versionArguments",
      "type": "object"
     },
     "name": "version"
    },
    {
     "description": "List all available AI agent CLIs (Claude Code, OpenCode, BYOK).\n\nReturns agent IDs, names, versions, availability status, and paths.\n",
     "inputSchema": {
      "properties": {},
      "title": "list_agentsArguments",
      "type": "object"
     },
     "name": "list_agents"
    },
    {
     "description": "List OpenDesign's external connectors (GitHub, Notion, Google Drive...) with their status and tool names.\n\nOnly ids, names, provider, category, status, whether it is configured and tool names are returned.",
     "inputSchema": {
      "properties": {},
      "title": "list_connectorsArguments",
      "type": "object"
     },
     "name": "list_connectors"
    },
    {
     "description": "List all design projects with their status, creation time, and metadata.",
     "inputSchema": {
      "properties": {},
      "title": "list_projectsArguments",
      "type": "object"
     },
     "name": "list_projects"
    },
    {
     "description": "Get detailed information about a specific project by ID.\n\nArgs:\n    project_id: UUID of the project (e.g. '38c010dc-f7c8-4a35-a325-89d6f56e45a4')\n",
     "inputSchema": {
      "properties": {
       "project_id": {
        "title": "Project Id",
        "type": "string"
       }
      },
      "required": [
       "project_id"
      ],
      "title": "get_projectArguments",
      "type": "object"
     },
     "name": "get_project"
    },
    {
     "description": "Create a new design project by sending an initial prompt to an OpenDesign AI agent.\n\nThis runs the agent (it may use paid model credits of the signed-in account). The call follows the run for\nabout 75 seconds at most; a longer run keeps going in OpenDesign (status \"running\": check list_runs or\nlist_project_files later). The result has projectId, runId, status (succeeded, failed, cancelled, running,\nunknown), the agent's text (shortened) and, on failure, errorCode with a hint.\n\nArgs:\n    prompt: The initial design prompt (e.g. 'Create a landing page for a coffee shop')\n    agent_id: Agent id from list_agents (e.g. 'claude', 'codex', 'opencode'). Default: 'claude'\n",
     "inputSchema": {
      "properties": {
       "agent_id": {
        "default": "claude",
        "title": "Agent Id",
        "type": "string"
       },
       "prompt": {
        "title": "Prompt",
        "type": "string"
       }
      },
      "required": [
       "prompt"
      ],
      "title": "create_projectArguments",
      "type": "object"
     },
     "name": "create_project"
    },
    {
     "description": "Permanently delete a project and all its files. This action cannot be undone.\n\nArgs:\n    project_id: UUID of the project to delete\n",
     "inputSchema": {
      "properties": {
       "project_id": {
        "title": "Project Id",
        "type": "string"
       }
      },
      "required": [
       "project_id"
      ],
      "title": "delete_projectArguments",
      "type": "object"
     },
     "name": "delete_project"
    },
    {
     "description": "List all files in a project directory with metadata (name, size, type, mime).\n\nArgs:\n    project_id: UUID of the project\n",
     "inputSchema": {
      "properties": {
       "project_id": {
        "title": "Project Id",
        "type": "string"
       }
