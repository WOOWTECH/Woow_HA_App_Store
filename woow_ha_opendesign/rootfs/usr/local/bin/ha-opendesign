#!/usr/bin/env bash
set -Eeuo pipefail

readonly DATA_DIR=/data/opendesign
readonly NGINX_TMP=/tmp/ha-opendesign-nginx
readonly SHUTDOWN_GRACE_SECONDS=5
# Supervised children (OpenDesign, nginx, ttyd and the built-in MCP server). Every process started with start_child is required:
# when any one exits, the launcher stops the others and exits so Supervisor
# restarts the complete set. Add a process with one more start_child call below.
child_pids=()
child_names=()
stopping=0

terminate_children() {
  if (( stopping )); then
    return
  fi
  stopping=1
  trap - TERM INT
  local pid deadline
  for pid in "${child_pids[@]}"; do
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
      kill -TERM "$pid" 2>/dev/null || true
    fi
  done

  deadline=$((SECONDS + SHUTDOWN_GRACE_SECONDS))
  while (( SECONDS < deadline )); do
    local alive=0
    for pid in "${child_pids[@]}"; do
      if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
        alive=1
      fi
    done
    (( alive == 0 )) && break
    sleep 0.1
  done

  for pid in "${child_pids[@]}"; do
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
      echo "[ha-opendesign] process $pid exceeded ${SHUTDOWN_GRACE_SECONDS}s grace; sending KILL" >&2
      kill -KILL "$pid" 2>/dev/null || true
    fi
  done
  for pid in "${child_pids[@]}"; do
    if [[ -n "$pid" ]]; then
      wait "$pid" 2>/dev/null || true
    fi
  done
}

trap terminate_children TERM INT

# start_child <name> <command...>: run a required process in the background.
start_child() {
  local name=$1
  shift
  "$@" &
  child_pids+=("$!")
  child_names+=("$name")
}

child_name() {
  local i
  for i in "${!child_pids[@]}"; do
    if [[ "${child_pids[$i]}" == "$1" ]]; then
      printf '%s' "${child_names[$i]}"
      return
    fi
  done
  printf 'unknown'
}

prepare_owned_dir() {
  local dir=$1 owner=${2:-open-design:open-design}
  if [[ -L "$dir" ]]; then
    echo "[ha-opendesign] refusing symbolic-link runtime directory: $dir" >&2
    exit 78
  fi
  if [[ -e "$dir" ]]; then
    if [[ ! -d "$dir" ]]; then
      echo "[ha-opendesign] runtime path is not a directory: $dir" >&2
      exit 78
    fi
  else
    # Parents are prepared first, so plain mkdir never traverses a child path
    # that has not already passed the no-symlink check.
    mkdir -- "$dir"
  fi
  if [[ -L "$dir" || ! -d "$dir" ]]; then
    echo "[ha-opendesign] runtime directory changed during validation: $dir" >&2
    exit 78
  fi
  # -h/--no-dereference prevents a late symlink swap from changing its target.
  chown -h "$owner" "$dir"
}

remove_obsolete_credentials() {
  local legacy_dir="$DATA_DIR/credentials"
  if [[ ! -e "$legacy_dir" && ! -L "$legacy_dir" ]]; then
    return
  fi

  # rm removes a symlink itself rather than following it. Check explicitly so a
  # legacy symlink is never treated as a directory, and never remove DATA_DIR.
  if [[ -L "$legacy_dir" ]]; then
    rm -f -- "$legacy_dir"
  else
    rm -rf -- "$legacy_dir"
  fi
}

# 0.2.1 retired the Omnigent host (0.2.0 ran the woow-paas-charts omnigent-host
# kit beside OpenDesign). Its state, including the stored Omnigent login, is
# MOVED once out of the agents' home into a 0700 backup the user can delete;
# nothing is deleted. Idempotent: once moved, there is nothing left to move.
retire_omnigent_state() {
  local source="$DATA_DIR/home/.omnigent" backups="$DATA_DIR/.backup" target
  if [[ ! -e "$source" && ! -L "$source" ]]; then
    return
  fi
  prepare_owned_dir "$backups"
  chmod 0700 "$backups"
  target="$backups/omnigent-$(date -u +%Y%m%dT%H%M%SZ)"
  if [[ -e "$target" || -L "$target" ]]; then
    target="$target-$$"
  fi
  # A rename inside /data: a symlink is moved as the link itself, never followed.
  mv -- "$source" "$target"
  if [[ -d "$target" && ! -L "$target" ]]; then
    chmod 0700 "$target"
  fi
  echo "[ha-opendesign] Omnigent was removed in 0.2.1: moved its state (with the stored Omnigent login) to ${target}; delete it when no longer needed" >&2
}

# A Home Assistant backup restore extracts /data without the original owners:
# OpenDesign's database and project files come back as root, and the daemon
# (UID 1001) then fails with SQLITE_READONLY (measured on HAOS 18.1 /
# Supervisor 2026.09.3). Return everything under DATA_DIR to open-design.
# -xdev stays on this mount and chown -h changes a symlink itself, never its
# target, so nothing outside /data/opendesign is touched. A normal start finds
# nothing to change.
repair_data_ownership() {
  local count
  count=$(find "$DATA_DIR" -xdev \( ! -user open-design -o ! -group open-design \) -print | wc -l)
  if [[ "$count" -eq 0 ]]; then
    return
  fi
  find "$DATA_DIR" -xdev \( ! -user open-design -o ! -group open-design \) -exec chown -h open-design:open-design {} +
  echo "[ha-opendesign] returned ${count} path(s) under ${DATA_DIR} to open-design (owners are not kept by a backup restore)" >&2
}

if [[ $(id -u) -ne 0 ]]; then
  echo "[ha-opendesign] launcher must start as root to prepare the HA /data mount" >&2
  exit 78
fi

owned_dirs=(
  "$DATA_DIR"
  "$DATA_DIR/home"
  "$DATA_DIR/shared"
  "$DATA_DIR/shared/skills"
  "$DATA_DIR/shared/mcp"
  "$DATA_DIR/shared/plugins"
  "$DATA_DIR/shared/workspaces"
  "$DATA_DIR/export-render"
  "$DATA_DIR/export-pdf"
)
for dir in "${owned_dirs[@]}"; do
  prepare_owned_dir "$dir"
done
repair_data_ownership
# nginx runs as its own UID (ha-ingress): besides the built-in MCP server it is
# the only process that may open the MCP administration socket, which
# OpenDesign, its agents and the ttyd shell (UID 1001) cannot.
for dir in "$NGINX_TMP" "$NGINX_TMP/client" "$NGINX_TMP/proxy" "$NGINX_TMP/fastcgi" "$NGINX_TMP/uwsgi" "$NGINX_TMP/scgi"; do
  prepare_owned_dir "$dir" ha-ingress:ha-ingress
done
for dir in "$DATA_DIR" "$DATA_DIR/home" "$DATA_DIR/export-render" "$DATA_DIR/export-pdf"; do
  [[ ! -L "$dir" && -d "$dir" ]] || {
    echo "[ha-opendesign] refusing unsafe chmod target: $dir" >&2
    exit 78
  }
  chmod 0750 "$dir"
done
retire_omnigent_state
# Agent CLI config homes (CODEX_HOME etc. below). Codex warns when its home is
# missing, so create the absent ones. Existing entries are the user's and are
# left exactly as they are (including symlinks): this never fails startup.
for dir in "$DATA_DIR/home/.claude" "$DATA_DIR/home/.codex" "$DATA_DIR/home/.config" \
  "$DATA_DIR/home/.pi" "$DATA_DIR/home/.pi/agent"; do
  if [[ ! -e "$dir" && ! -L "$dir" && -d "${dir%/*}" && ! -L "${dir%/*}" ]]; then
    mkdir -- "$dir" && chown -h open-design:open-design "$dir"
  fi
done
remove_obsolete_credentials

export OD_DATA_DIR="$DATA_DIR"
export OD_BIND_HOST=127.0.0.1
export OD_PORT=7456
export OD_DAEMON_URL=http://127.0.0.1:7456
export HOME="$DATA_DIR/home"
export HA_OPENDESIGN_HOME="$DATA_DIR/home"
export CLAUDE_CONFIG_DIR="$HOME/.claude"
export CODEX_HOME="$HOME/.codex"
export PI_CODING_AGENT_DIR="$HOME/.pi/agent"
export XDG_CONFIG_HOME="$HOME/.config"

# Opt the agent CLIs (and their libraries) out of telemetry, as in 0.2.0.
export DO_NOT_TRACK=1
export DISABLE_TELEMETRY=1

# Supervisor credentials stay with this root launcher. No child needs them:
# OpenDesign, its agents, nginx, the CLI Terminal shell and the built-in MCP
# server (its administration relies on the HA Ingress login) all start without.
no_supervisor_env=(/usr/bin/env -u SUPERVISOR_TOKEN -u HASSIO_TOKEN)

start_child opendesign \
  "${no_supervisor_env[@]}" su-exec open-design:open-design /usr/local/bin/node /opt/ha-opendesign/headless-entry.mjs
# `-e stderr` uses the inherited descriptor directly; reopening /dev/stderr is
# denied when HA's root PID 1 drops to an unprivileged UID under its procfs.
start_child nginx \
  "${no_supervisor_env[@]}" su-exec ha-ingress:ha-ingress /usr/sbin/nginx -e stderr -c /etc/nginx/nginx.conf
start_child ttyd \
  "${no_supervisor_env[@]}" su-exec open-design:open-design /usr/bin/ttyd \
  --port 7681 --interface 127.0.0.1 --base-path /terminal \
  --writable --check-origin --max-clients 1 \
  --cwd "$HOME" /bin/bash --login
# Built-in MCP server: starts as root only to own /data/mcp and
# /run/ha-opendesign-mcp, then drops itself to UID 10001 (mcp). LAN MCP on
# 0.0.0.0:8081 (Bearer or /private_<token>/mcp), administration via Ingress
# /mcp-admin/. It is always on and, like every child, required.
start_child mcp \
  "${no_supervisor_env[@]}" /opt/woow/bin/ha-opendesign-mcp

exited_pid=''
set +e
wait -n -p exited_pid "${child_pids[@]}"
status=$?
set -e

if (( stopping )); then
  # TERM/INT interrupted the wait; the trap has already stopped every child.
  echo "[ha-opendesign] stop requested (status=$status); all processes stopped" >&2
else
  echo "[ha-opendesign] required process $(child_name "${exited_pid:-}") exited (status=$status); stopping its peers" >&2
  terminate_children
fi

# A clean but unexpected child exit still requires Supervisor to restart us.
if (( status == 0 )); then
  status=1
fi
exit "$status"
