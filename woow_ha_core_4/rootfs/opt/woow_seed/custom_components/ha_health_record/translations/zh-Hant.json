{
  "title": "健康紀錄",
  "entity": {
    "sensor": {
      "record": {
        "name": "{record_name} 紀錄"
      }
    },
    "number": {
      "record_value": {
        "name": "{record_name} 數值"
      }
    },
    "button": {
      "record_log": {
        "name": "{record_name} 紀錄"
      }
    },
    "text": {
      "record_note": {
        "name": "{record_name} 備註"
      }
    }
  },
  "services": {
    "get_members": {
      "name": "取得成員列表",
      "description": "列出所有家庭成員及其紀錄類型。"
    },
    "get_records": {
      "name": "取得紀錄",
      "description": "查詢時間範圍內的健康紀錄。",
      "fields": {
        "start_time": { "name": "開始時間", "description": "時間範圍的起點（ISO 8601 格式）。" },
        "end_time": { "name": "結束時間", "description": "時間範圍的終點（ISO 8601 格式）。" }
      }
    },
    "export_csv": {
      "name": "匯出 CSV",
      "description": "將成員的所有紀錄匯出為 CSV 文字。",
      "fields": {
        "member_id": { "name": "成員 ID", "description": "成員的唯一識別碼。" }
      }
    },
    "log_record": {
      "name": "記錄數值",
      "description": "為成員新增一筆健康紀錄。",
      "fields": {
        "member_id": { "name": "成員 ID", "description": "成員的唯一識別碼。" },
        "record_type": { "name": "紀錄類型", "description": "紀錄類型 ID（如 weight、feeding）。" },
        "value": { "name": "數值", "description": "測量值。" },
        "note": { "name": "備註", "description": "選填的文字備註。" },
        "timestamp": { "name": "時間戳記", "description": "選填的 ISO 8601 時間戳記，預設為現在。" }
      }
    },
    "update_record": {
      "name": "更新紀錄",
      "description": "更新既有的健康紀錄。",
      "fields": {
        "member_id": { "name": "成員 ID", "description": "成員的唯一識別碼。" },
        "type_id": { "name": "類型 ID", "description": "紀錄類型 ID。" },
        "timestamp": { "name": "時間戳記", "description": "用來定位紀錄的 ISO 8601 時間戳記。" },
        "record_id": { "name": "紀錄 ID", "description": "選填的紀錄 UUID（優先於時間戳記）。" },
        "value": { "name": "數值", "description": "新的紀錄數值。" },
        "note": { "name": "備註", "description": "新的紀錄備註。" },
        "new_timestamp": { "name": "新時間戳記", "description": "替換用的時間戳記（ISO 8601）。" }
      }
    },
    "delete_record": {
      "name": "刪除紀錄",
      "description": "刪除一筆健康紀錄。",
      "fields": {
        "member_id": { "name": "成員 ID", "description": "成員的唯一識別碼。" },
        "type_id": { "name": "類型 ID", "description": "紀錄類型 ID。" },
        "timestamp": { "name": "時間戳記", "description": "用來定位紀錄的 ISO 8601 時間戳記。" },
        "record_id": { "name": "紀錄 ID", "description": "選填的紀錄 UUID（優先於時間戳記）。" }
      }
    },
    "add_record_type": {
      "name": "新增紀錄類型",
      "description": "為成員新增一個紀錄類型。",
      "fields": {
        "member_id": { "name": "成員 ID", "description": "成員的唯一識別碼。" },
        "name": { "name": "名稱", "description": "紀錄類型的顯示名稱。" },
        "unit": { "name": "單位", "description": "量測單位（如 kg、bpm）。" },
        "default_value": { "name": "預設值", "description": "初始預設值。" },
        "default_value_mode": { "name": "預設值模式", "description": "\"fixed\"（固定值）或 \"last_value\"（上次值）。" }
      }
    },
    "update_record_type": {
      "name": "更新紀錄類型",
      "description": "更新既有紀錄類型的設定。",
      "fields": {
        "member_id": { "name": "成員 ID", "description": "成員的唯一識別碼。" },
        "type_id": { "name": "類型 ID", "description": "要更新的紀錄類型 ID。" },
        "name": { "name": "名稱", "description": "新的顯示名稱。" },
        "unit": { "name": "單位", "description": "新的量測單位。" },
        "default_value": { "name": "預設值", "description": "新的預設值。" },
        "default_value_mode": { "name": "預設值模式", "description": "\"fixed\"（固定值）或 \"last_value\"（上次值）。" }
      }
    },
    "delete_record_type": {
      "name": "刪除紀錄類型",
      "description": "刪除紀錄類型及其關聯的實體。",
      "fields": {
        "member_id": { "name": "成員 ID", "description": "成員的唯一識別碼。" },
        "type_id": { "name": "類型 ID", "description": "要刪除的紀錄類型 ID。" }
      }
    },
    "add_member": {
      "name": "新增成員",
      "description": "新增一位家庭成員來追蹤健康紀錄。",
      "fields": {
        "name": { "name": "名稱", "description": "新成員的顯示名稱。" },
        "member_id": { "name": "成員 ID", "description": "選填的唯一識別碼，留空則從名稱自動產生。" },
        "note": { "name": "備註", "description": "選填的文字備註。" }
      }
    },
    "update_member": {
      "name": "更新成員",
      "description": "更新成員的顯示名稱和備註。",
      "fields": {
        "member_id": { "name": "成員 ID", "description": "成員的唯一識別碼。" },
        "name": { "name": "名稱", "description": "新的顯示名稱。" },
        "note": { "name": "備註", "description": "新的備註。" }
      }
    },
    "delete_member": {
      "name": "刪除成員",
      "description": "刪除成員及其所有相關資料。",
      "fields": {
        "member_id": { "name": "成員 ID", "description": "成員的唯一識別碼。" }
      }
    }
  },
  "exceptions": {
    "member_not_found": { "message": "找不到成員「{member_id}」。" },
    "record_type_not_found": { "message": "在成員「{member_id}」中找不到紀錄類型「{record_type}」。" },
    "record_not_found": { "message": "找不到紀錄。" },
    "invalid_datetime": { "message": "欄位「{field}」的日期時間格式無效：{value}" },
    "log_failed": { "message": "紀錄寫入失敗。" },
    "invalid_type_id": { "message": "名稱必須包含至少一個英數字元。" },
    "type_exists": { "message": "紀錄類型「{type_id}」已存在。" },
    "type_not_found": { "message": "找不到紀錄類型「{type_id}」。" },
    "invalid_member_id": { "message": "清理後的成員 ID 為空。" },
    "member_exists": { "message": "成員「{member_id}」已存在。" },
    "create_failed": { "message": "建立成員失敗。" }
  },
  "config": {
    "step": {
      "user": {
        "title": "新增家庭成員",
        "description": "新增一位家庭成員來追蹤健康紀錄。",
        "data": {
          "member_name": "名稱",
          "member_id": "ID（選填，留空自動產生）"
        }
      }
    },
    "error": {
      "already_configured": "此成員已經設定過了。"
    },
    "abort": {
      "already_configured": "此成員已經設定過了。"
    }
  }
}
